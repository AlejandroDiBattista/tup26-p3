@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<tp5.Data.AgendaDbContext> DbFactory
@using Microsoft.EntityFrameworkCore
@using tp5.Models

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="container-fluid mt-4">
    <h2 class="text-center fw-bold mb-4">
        <i class="bi bi-person-lines-fill"></i> TP5: AgendaWeb
    </h2>

    <div class="row mb-4 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Buscar por nombre, apellido o teléfono..." 
                       @bind="textoBusqueda" @bind:event="oninput" @onkeyup="FiltrarContactos" />
            </div>
        </div>
        <div class="col-md-7 text-end">
            <button class="btn btn-success shadow-sm" @onclick="IniciarNuevoContacto">
                <i class="bi bi-plus-circle"></i> Nuevo Contacto
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 border-end" style="max-height: 65vh; overflow-y: auto;">
            <div class="list-group shadow-sm">
                @if (contactosFiltrados == null)
                {
                    <div class="text-center p-3">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Cargando la agenda...</p>
                    </div>
                }
                else if (!contactosFiltrados.Any())
                {
                    <div class="alert alert-warning text-center m-2">
                        No se encontraron contactos.
                    </div>
                }
                else
                {
                    @foreach (var c in contactosFiltrados)
                    {
                        <button type="button" 
                                class="list-group-item list-group-item-action p-3 @(contactoSeleccionado?.Id == c.Id ? "active text-white" : "")"
                                @onclick="() => SeleccionarContacto(c)">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <strong class="mb-1 text-capitalize">@c.Apellido, @c.Nombre</strong>
                            </div>
                            <small class="d-block @(contactoSeleccionado?.Id == c.Id ? "text-white-50" : "text-muted")">
                                <i class="bi bi-telephone"></i> @c.Telefono
                            </small>
                        </button>
                    }
                }
            </div>
        </div>

        <div class="col-md-8 ps-4">
            @if (editando)
            {
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">@(contactoModel.Id == 0 ? "📝 Registrar Nuevo Contacto" : "✏️ Modificar Información")</h4>
                    </div>
                    <div class="card-body py-3">
                        <EditForm Model="contactoModel" OnValidSubmit="GuardarContacto">
                            <DataAnnotationsValidator />
                            
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold mb-1">Nombre *</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="contactoModel.Nombre" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold mb-1">Apellido *</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="contactoModel.Apellido" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold mb-1">Teléfono *</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="contactoModel.Telefono" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold mb-1">Correo Electrónico *</label>
                                    <InputText type="email" class="form-control form-control-sm" @bind-Value="contactoModel.Email" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Empresa</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="contactoModel.Empresa" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Cargo</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="contactoModel.Cargo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Fecha de Nacimiento</label>
                                    <InputDate class="form-control form-control-sm" @bind-Value="contactoModel.FechaNacimiento" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label mb-1">Dirección</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="contactoModel.Direccion" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label mb-1">Notas o Comentarios</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="contactoModel.Notas" />
                                </div>
                            </div>

                            <div class="mt-3 pt-2 border-top text-end">
                                <button type="button" class="btn btn-sm btn-secondary me-2" @onclick="CancelarEdicion">Cancelar</button>
                                <button type="submit" class="btn btn-sm btn-primary px-4">Guardar Cambios</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else if (contactoSeleccionado != null)
            {
                <div class="card shadow-sm border-light">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h2 class="card-title text-primary fw-bold mb-1">@contactoSeleccionado.Nombre @contactoSeleccionado.Apellido</h2>
                                @if (!string.IsNullOrEmpty(contactoSeleccionado.Cargo) || !string.IsNullOrEmpty(contactoSeleccionado.Empresa))
                                {
                                    <span class="badge bg-secondary p-2 fs-6">
                                        @contactoSeleccionado.Cargo @(string.IsNullOrEmpty(contactoSeleccionado.Empresa) ? "" : $"en {contactoSeleccionado.Empresa}")
                                    </span>
                                }
                            </div>
                        </div>
                        <hr class="my-2" />
                        
                        <div class="row fs-5 g-2">
                            <div class="col-md-6">
                                <div class="p-2 border rounded bg-light mb-2">
                                    <strong>📞 Teléfono:</strong> <span class="text-secondary d-block fs-6">@contactoSeleccionado.Telefono</span>
                                </div>
                                <div class="p-2 border rounded bg-light">
                                    <strong>✉️ Correo:</strong> <span class="text-secondary d-block fs-6 text-break">@contactoSeleccionado.Email</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 border rounded bg-light mb-2">
                                    <strong>📅 Cumpleaños:</strong> 
                                    <span class="text-secondary d-block fs-6">
                                        @(contactoSeleccionado.FechaNacimiento.HasValue ? contactoSeleccionado.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "No especificado")
                                    </span>
                                </div>
                                <div class="p-2 border rounded bg-light">
                                    <strong>📍 Dirección:</strong> <span class="text-secondary d-block fs-6 text-truncate">@(string.IsNullOrEmpty(contactoSeleccionado.Direccion) ? "No especificada" : contactoSeleccionado.Direccion)</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(contactoSeleccionado.Notas))
                            {
                                <div class="col-12 mt-2">
                                    <div class="bg-light p-2 rounded border">
                                        <strong>📝 Notas adicionales:</strong>
                                        <p class="mb-0 text-muted mt-1 fs-6 whitespace-pre-line">@contactoSeleccionado.Notas</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-3 pt-2 border-top text-end">
                            <button class="btn btn-sm btn-warning me-2 fw-bold text-dark" @onclick="HabilitarEdicion">
                                <i class="bi bi-pencil-square"></i> Editar
                            </button>
                            <button class="btn btn-sm btn-danger fw-bold" @onclick="EliminarContacto">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center text-muted mt-5 py-5 bg-light rounded border border-dashed">
                    <i class="bi bi-arrow-left-circle display-4 text-secondary mb-3 d-block"></i>
                    <h4>Seleccioná un contacto de la lista para ver sus datos</h4>
                    <p>O podés registrar uno nuevo haciendo clic en el botón verde de arriba.</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Variables para manejar todo lo de la página
    private List<Contacto> todosLosContactos = new(); // Acá guardo la lista completa que traigo de la base de datos
    private List<Contacto> contactosFiltrados = new(); // Esta es la lista que se muestra y varía según lo que busque
    private Contacto? contactoSeleccionado; // Para saber qué contacto hizo clic el usuario
    private Contacto contactoModel = new(); // El modelo temporal para meter en el formulario
    
    private string textoBusqueda = ""; // Lo que escribe el usuario en el buscador
    private bool editando = false; // Bandera para saber si muestro el formulario o la vista de detalle

    // Cuando arranca la página, cargo los datos al toque
    protected override async Task OnInitializedAsync()
    {
        await CargarContactosDesdeBase();
    }

    // Traigo los contactos ordenados por apellido y nombre usando el DbContext
    private async Task CargarContactosDesdeBase()
    {
        using var context = DbFactory.CreateDbContext();
        todosLosContactos = await context.Contactos.OrderBy(c => c.Apellido).ThenBy(c => c.Nombre).ToListAsync();
        FiltrarContactos(); // Inicializo la lista filtrada
    }

    // Lógica para filtrar la lista según lo que pongan en el buscador
    private void FiltrarContactos()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            // Si no escribieron nada, muestro todo de una
            contactosFiltrados = todosLosContactos;
        }
        else
        {
            // Busco coincidencias por nombre, apellido o teléfono sin importar mayúsculas
            contactosFiltrados = todosLosContactos
                .Where(c => c.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) || 
                            c.Apellido.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                            c.Telefono.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    // Reseteo el estado de edición
    private void AppDataChangeReset()
    {
        editando = false;
    }

    // Cuando elijo un contacto de la lista, lo pongo en pantalla y cierro el formulario por las dudas
    private void SeleccionarContacto(Contacto contacto)
    {
        contactoSeleccionado = contacto;
        AppDataChangeReset();
    }

    // Dejo el modelo en blanco para cuando quieren cargar un contacto nuevo
    private void IniciarNuevoContacto()
    {
        contactoModel = new Contacto(); 
        contactoSeleccionado = null;
        editando = true;
    }

    // Copio los datos del contacto a editar al modelo temporal
    private void HabilitarEdicion()
    {
        if (contactoSeleccionado != null)
        {
            // Hago un clon para que si el usuario borra algo y cancela, no me rompa la lista original
            contactoModel = new Contacto
            {
                Id = contactoSeleccionado.Id,
                Nombre = contactoSeleccionado.Nombre,
                Apellido = contactoSeleccionado.Apellido,
                Telefono = contactoSeleccionado.Telefono,
                Email = contactoSeleccionado.Email,
                Empresa = contactoSeleccionado.Empresa,
                Cargo = contactoSeleccionado.Cargo,
                Direccion = contactoSeleccionado.Direccion,
                FechaNacimiento = contactoSeleccionado.FechaNacimiento,
                Notas = contactoSeleccionado.Notas
            };
            editando = true;
        }
    }

    // Si cancelan la edición, cierro el formulario y vuelvo a mostrar el contacto original
    private void CancelarEdicion()
    {
        editando = false;
        if (contactoModel.Id != 0)
        {
            contactoSeleccionado = todosLosContactos.FirstOrDefault(c => c.Id == contactoModel.Id);
        }
    }

    // Guardo los cambios o creo el registro en la base de datos
    private async Task GuardarContacto()
    {
        using var context = DbFactory.CreateDbContext();

        if (contactoModel.Id == 0)
        {
            // Si el ID es 0, es porque es un contacto nuevo
            context.Contactos.Add(contactoModel);
        }
        else
        {
            // Si ya tiene ID, actualizo el que corresponde
            context.Contactos.Update(contactoModel);
        }

        await context.SaveChangesAsync(); // Guardo los cambios en el archivo .db
        editando = false;
        
        await CargarContactosDesdeBase(); // Recargo la lista completa
        
        // Vuelvo a seleccionar el contacto que guardé para que quede visible
        contactoSeleccionado = todosLosContactos.FirstOrDefault(c => c.Id == contactoModel.Id)
                              ?? todosLosContactos.FirstOrDefault(c => c.Telefono == contactoModel.Telefono);
    }

    // Borro el contacto de la base de datos SQLite
    // Borro el contacto de la base de datos SQLite
    private async Task EliminarContacto()
    {
        if (contactoSeleccionado != null)
        {
            using var context = DbFactory.CreateDbContext();
            context.Contactos.Remove(contactoSeleccionado);
            await context.SaveChangesAsync();
            
            contactoSeleccionado = null; // Limpio la pantalla de detalle
            await CargarContactosDesdeBase(); // Actualizo la lista de la izquierda
        }
    }
}