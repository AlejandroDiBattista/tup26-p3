@page "/"

@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using tp5.Models

@inject AgendaDbContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

<h1 class="text-center my-4">
    <i class="bi bi-person-vcard me-2"></i>
    TP5: AgendaWeb
</h1>

@if (contactos == null)
{
    <p>Cargando contactos...</p>
}
else
{
    <div class="row">

        <div class="col-md-4">
            <button class="btn btn-success w-100 mb-3"
                    @onclick="MostrarFormulario">
                <i class="bi bi-plus-circle"></i>
                Nuevo Contacto
            </button>

            <div class="mb-3">
                <InputText class="form-control"
               placeholder="Buscar contacto..."
               @bind-Value="textoBusqueda"
               @bind-Value:event="oninput" />
            </div>
            @if (mostrandoFormulario)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        Nuevo Contacto
                    </div>

                    <div class="card-body">

                        <EditForm Model="nuevoContacto"
                        OnValidSubmit="GuardarContacto">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                            <div class="mb-2">
                                <InputText class="form-control"
                                           @bind-Value="nuevoContacto.Nombre"
                                           placeholder="Nombre" />
                            </div>

                            <div class="mb-2">
                                <InputText class="form-control"
                                           @bind-Value="nuevoContacto.Apellido"
                                           placeholder="Apellido" />
                            </div>

                            <div class="mb-2">
                                <InputText class="form-control"
                                           @bind-Value="nuevoContacto.Telefono"
                                           placeholder="Teléfono" />
                            </div>

                            <div class="mb-2">
                                <InputText class="form-control"
                                           @bind-Value="nuevoContacto.Email"
                                           placeholder="Email" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar
                            </button>

                        </EditForm>

                    </div>
                </div>
            }
            <div class="list-group">

                @foreach (var contacto in ContactosFiltrados())
                {
                    @if (!ContactosFiltrados().Any())
                    {
                        <div class="alert alert-warning mt-2">
                            No se encontraron contactos.
                        </div>
                    }
                    <button class="list-group-item list-group-item-action @(contacto == seleccionado ? "active" : "")"
                        @onclick="() => Seleccionar(contacto)">

                        @contacto.Apellido, @contacto.Nombre
                    </button>
                }

            </div>
        </div>

        <div class="col-md-8">

            @if (seleccionado != null)
            {
                <div class="card">

                    <div class="card-header d-flex justify-content-between">

                        <span>Detalle del contacto</span>

                        <div>

                            <button class="btn btn-warning btn-sm me-2"
                            @onclick="EditarContacto">
                            <i class="bi bi-pencil"></i>
                            Editar
                            </button>

                        <button class="btn btn-warning btn-sm"
                                @onclick="EliminarContacto">
                            <i class="bi bi-trash"></i>
                            Eliminar
                        </button>

                        </div>

                    </div>

                    <div class="card-body">

                        @if (editando)
                        {
                            <EditForm Model="contactoEditado"
                            OnValidSubmit="GuardarEdicion">
                            <DataAnnotationsValidator /> 
                            <ValidationSummary />

                                <div class="mb-2">
                                    <InputText class="form-control"
                                               @bind-Value="contactoEditado.Nombre" />
                                </div>

                                <div class="mb-2">
                                    <InputText class="form-control"
                                               @bind-Value="contactoEditado.Apellido" />
                                </div>

                                <div class="mb-2">
                                    <InputText class="form-control"
                                               @bind-Value="contactoEditado.Telefono" />
                                </div>

                                <div class="mb-2">
                                    <InputText class="form-control"
                                               @bind-Value="contactoEditado.Email" />
                                </div>

                                <div class="mb-2">
                                    <InputText class="form-control"
                                               @bind-Value="contactoEditado.Empresa" />
                                </div>

                                <div class="mb-2">
                                    <InputText class="form-control"
                                               @bind-Value="contactoEditado.Cargo" />
                                </div>

                                <div class="mb-2">
                                    <InputText class="form-control"
                                               @bind-Value="contactoEditado.Direccion" />
                                </div>

                                <button type="submit"
                                        class="btn btn-success">
                                    Guardar cambios
                                </button>

                            </EditForm>
                        }
                        else
                        {
                            <h4>
                                @seleccionado.Nombre
                                @seleccionado.Apellido
                            </h4>

                            <p>
                                <strong>Teléfono:</strong>
                                @seleccionado.Telefono
                            </p>

                            <p>
                                <strong>Email:</strong>
                                @seleccionado.Email
                            </p>

                            <p>
                                <strong>Empresa:</strong>
                                @seleccionado.Empresa
                            </p>

                            <p>
                                <strong>Cargo:</strong>
                                @seleccionado.Cargo
                            </p>

                            <p>
                                <strong>Dirección:</strong>
                                @seleccionado.Direccion
                            </p>

                            <p>
                                <strong>Fecha Nacimiento:</strong>
                                @seleccionado.FechaNacimiento
                            </p>

                            <p>
                                <strong>Notas:</strong>
                                @seleccionado.Notas
                            </p>
                        }

                    </div>

                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Seleccione un contacto.
                </div>
            }

        </div>

    </div>
}

@code {
    private List<Contacto>? contactos;
    private Contacto? seleccionado;

    private bool mostrandoFormulario = false;
    private bool editando = false;

    private Contacto nuevoContacto = new();
    private Contacto contactoEditado = new();

    private string textoBusqueda = "";

    protected override async Task OnInitializedAsync()
    {
        contactos = await Db.Contactos.ToListAsync();

        seleccionado = contactos.FirstOrDefault();
    }

    private void Seleccionar(Contacto contacto)
    {
        seleccionado = contacto;
    }

    private void MostrarFormulario()
    {
        mostrandoFormulario = !mostrandoFormulario;
    }

    private async Task GuardarContacto()
    {
        Db.Contactos.Add(nuevoContacto);

        await Db.SaveChangesAsync();

        contactos = await Db.Contactos.ToListAsync();

        seleccionado = nuevoContacto;

        nuevoContacto = new Contacto();

        mostrandoFormulario = false;
    }

    private void EditarContacto()
    {
        if (seleccionado == null)
            return;

        contactoEditado = new Contacto
        {
            Id = seleccionado.Id,
            Nombre = seleccionado.Nombre,
            Apellido = seleccionado.Apellido,
            Telefono = seleccionado.Telefono,
            Email = seleccionado.Email,
            Empresa = seleccionado.Empresa,
            Cargo = seleccionado.Cargo,
            Direccion = seleccionado.Direccion,
            FechaNacimiento = seleccionado.FechaNacimiento,
            Notas = seleccionado.Notas
        };

        editando = true;
    }

    private async Task GuardarEdicion()
    {
        Db.Contactos.Update(contactoEditado);

        await Db.SaveChangesAsync();

        contactos = await Db.Contactos.ToListAsync();

        seleccionado = contactoEditado;

        editando = false;
    }

    private async Task EliminarContacto()
    {
    if (seleccionado == null)
        return;

    Db.Contactos.Remove(seleccionado);

    await Db.SaveChangesAsync();

    contactos = await Db.Contactos.ToListAsync();

    seleccionado = contactos.FirstOrDefault();

    editando = false;
    }

    private IEnumerable<Contacto> ContactosFiltrados()
        {
    if (string.IsNullOrWhiteSpace(textoBusqueda))
        return contactos ?? [];

    return contactos!.Where(c =>
        c.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
        || c.Apellido.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
        || c.Email.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));
        }
}

