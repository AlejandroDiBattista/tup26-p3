@page "/"
@rendermode InteractiveServer
@using tp5.Models
@using Microsoft.EntityFrameworkCore
@inject AgendaDbContext Db
@inject NavigationManager Nav

<PageTitle>TP5: AgendaWeb</PageTitle>

@code {
    private List<Contacto> contactos = new();
    private Contacto? seleccionado;

    protected override async Task OnInitializedAsync()
    {
        contactos = await Db.Contactos.ToListAsync();
    }
}
<div class="container-fluid px-4 py-4">

    <div class="agenda-header">
        <div>
            <h1>Agenda</h1>
            <p>Contactos personales y profesionales</p>
        </div>
        <button class="btn btn-primary" @onclick="IrANuevo">
            <i class="bi bi-plus-lg me-1"></i>Nuevo contacto
        </button>
    </div>

    <div class="row g-3">

    </div>
</div>

<div class="col-md-4">
    <div class="panel p-3">
        <div class="search-box mb-2">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input class="form-control border-start-0"
                       placeholder="Buscar contacto..."
                       @bind="busqueda" @bind:event="oninput" />
            </div>
        </div>
    </div>
</div>