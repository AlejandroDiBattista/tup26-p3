@page "/"
@rendermode InteractiveServer
@inject AgendaDb db
@inject IJSRuntime JS

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="p-4">
    <h1 class="mb-4"><i class="bi bi-person-vcard me-2"></i>TP5: AgendaWeb</h1>

    @if (contactos is null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <div class="row">
            <div class="col-4">
                <button class="btn btn-success btn-sm mb-2 w-100" @onclick="Nuevo">
                    <i class="bi bi-plus-lg me-1"></i>Nuevo contacto
                </button>

                <div class="list-group">
                    @foreach (var c in contactos)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action @(seleccionado?.Id == c.Id ? "active" : "")"
                                @onclick="() => Seleccionar(c)">
                            @c.Apellido, @c.Nombre
                        </button>
                    }
                </div>
            </div>

            <div class="col-8">
                @if (editando)
                {
                    <div class="card">
                        <div class="card-body">
                            <h3 class="card-title mb-3">@(enEdicion.Id == 0 ? "Nuevo contacto" : "Editar contacto")</h3>

                            <EditForm Model="enEdicion" OnValidSubmit="Guardar">
                                <div class="mb-2">
                                    <label class="form-label">Nombre *</label>
                                    <InputText class="form-control" @bind-Value="enEdicion.Nombre" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Apellido *</label>
                                    <InputText class="form-control" @bind-Value="enEdicion.Apellido" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Teléfono *</label>
                                    <InputText class="form-control" @bind-Value="enEdicion.Telefono" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Email *</label>
                                    <InputText class="form-control" @bind-Value="enEdicion.Email" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Empresa</label>
                                    <InputText class="form-control" @bind-Value="enEdicion.Empresa" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Cargo</label>
                                    <InputText class="form-control" @bind-Value="enEdicion.Cargo" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Dirección</label>
                                    <InputText class="form-control" @bind-Value="enEdicion.Direccion" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Fecha de nacimiento</label>
                                    <InputDate class="form-control" @bind-Value="enEdicion.FechaNacimiento" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Notas</label>
                                    <InputTextArea class="form-control" @bind-Value="enEdicion.Notas" />
                                </div>

                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i>Guardar
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                    Cancelar
                                </button>
                            </EditForm>
                        </div>
                    </div>
                }
                else if (seleccionado is null)
                {
                    <p class="text-muted">Elegí un contacto de la lista para ver su detalle.</p>
                }
                else
                {
                    <div class="card">
                        <div class="card-body">
                            <h3 class="card-title">@seleccionado.Nombre @seleccionado.Apellido</h3>
                            <h6 class="card-subtitle mb-3 text-muted">@seleccionado.Cargo @(string.IsNullOrWhiteSpace(seleccionado.Empresa) ? "" : $"— {seleccionado.Empresa}")</h6>

                            <dl class="row mb-0">
                                <dt class="col-sm-3">Teléfono</dt>
                                <dd class="col-sm-9">@seleccionado.Telefono</dd>

                                <dt class="col-sm-3">Email</dt>
                                <dd class="col-sm-9">@seleccionado.Email</dd>

                                <dt class="col-sm-3">Dirección</dt>
                                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(seleccionado.Direccion) ? "—" : seleccionado.Direccion)</dd>

                                <dt class="col-sm-3">Nacimiento</dt>
                                <dd class="col-sm-9">@(seleccionado.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</dd>

                                <dt class="col-sm-3">Notas</dt>
                                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(seleccionado.Notas) ? "—" : seleccionado.Notas)</dd>
                            </dl>

                            <div class="mt-3">
                                <button class="btn btn-primary me-2" @onclick="Editar">
                                    <i class="bi bi-pencil me-1"></i>Editar
                                </button>
                                <button class="btn btn-danger" @onclick="Eliminar">
                                    <i class="bi bi-trash me-1"></i>Eliminar
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    List<Contacto>? contactos;
    Contacto? seleccionado;
    bool editando = false;
    Contacto enEdicion = new();
    void Nuevo()
    {
        enEdicion = new Contacto();
        editando = true;
    }

    void Editar()
    {
        if (seleccionado is null) return;
        enEdicion = new Contacto
        {
            Id = seleccionado.Id,
            Nombre = seleccionado.Nombre,
            Apellido = seleccionado.Apellido,
            Telefono = seleccionado.Telefono,
            Email = seleccionado.Email,
            Empresa = seleccionado.Empresa,
            Cargo = seleccionado.Cargo,
            Direccion = seleccionado.Direccion,
            FechaNacimiento = seleccionado.FechaNacimiento,
            Notas = seleccionado.Notas,
        };
        editando = true;
    }

    void Cancelar()
    {
        editando = false;
    }

    async Task Guardar()
    {
        if (enEdicion.Id == 0)
        {
            // ALTA: es un contacto nuevo
            db.Contactos.Add(enEdicion);
        }
        else
        {
            // EDICIÓN: piso los datos del contacto existente
            var original = await db.Contactos.FindAsync(enEdicion.Id);
            if (original is null) return;

            original.Nombre = enEdicion.Nombre;
            original.Apellido = enEdicion.Apellido;
            original.Telefono = enEdicion.Telefono;
            original.Email = enEdicion.Email;
            original.Empresa = enEdicion.Empresa;
            original.Cargo = enEdicion.Cargo;
            original.Direccion = enEdicion.Direccion;
            original.FechaNacimiento = enEdicion.FechaNacimiento;
            original.Notas = enEdicion.Notas;
        }

        await db.SaveChangesAsync();

        editando = false;
        seleccionado = null;
        await CargarContactos();
    }
    protected override async Task OnInitializedAsync()
    {
        await CargarContactos();
    }

    async Task CargarContactos()
    {
        contactos = await db.Contactos.OrderBy(c => c.Apellido).ToListAsync();
    }

    void Seleccionar(Contacto c)
    {
        seleccionado = c;
    }

    async Task Eliminar()
    {
        if (seleccionado is null) return;

        bool confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Eliminar a {seleccionado.Nombre} {seleccionado.Apellido}?");
        if (!confirmado) return;

        db.Contactos.Remove(seleccionado);
        await db.SaveChangesAsync();

        seleccionado = null;
        await CargarContactos();
    }
}