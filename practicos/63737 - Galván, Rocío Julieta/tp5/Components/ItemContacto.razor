@using tp5.Models

<button class="list-group-item list-group-item-action @(Activo ? "active" : "")"
        @onclick="OnSeleccionar">

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-1">
                <i class="bi bi-person-fill me-2"></i>
                @Contacto.Nombre @Contacto.Apellido
            </h6>

            <small class="@(Activo ? "text-white-50" : "text-muted")">
                <i class="bi bi-envelope me-1"></i>
                @Contacto.Email
            </small>
        </div>

        <span class="badge @(Activo ? "bg-light text-dark" : "bg-light text-dark") rounded-pill">
            @Contacto.Empresa
        </span>
    </div>

</button>

@code {
    [Parameter]
    public Contacto Contacto { get; set; } = default!;

    [Parameter]
    public bool Activo { get; set; }

    [Parameter]
    public EventCallback OnSeleccionar { get; set; }
}