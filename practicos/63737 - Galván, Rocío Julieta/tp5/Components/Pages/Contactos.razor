@page "/contactos"
@rendermode InteractiveServer

@using tp5.Models
@using Microsoft.EntityFrameworkCore
@inject tp5.Data.AgendaDbContext Db

<div class="container py-4">

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h1 class="mb-0">Agenda</h1>
            <p class="text-muted mb-0">Contactos personales y profesionales</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4>Agregar / editar contacto</h4>

            <EditForm Model="nuevoContacto"
                      OnValidSubmit="GuardarContacto"
                      FormName="contactoForm">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="nuevoContacto.Nombre" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Apellido</label>
                        <InputText class="form-control" @bind-Value="nuevoContacto.Apellido" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="nuevoContacto.Telefono" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="nuevoContacto.Email" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Empresa</label>
                        <InputText class="form-control" @bind-Value="nuevoContacto.Empresa" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cargo</label>
                        <InputText class="form-control" @bind-Value="nuevoContacto.Cargo" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Dirección</label>
                        <InputText class="form-control" @bind-Value="nuevoContacto.Direccion" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Fecha de nacimiento</label>
                        <InputDate class="form-control" @bind-Value="nuevoContacto.FechaNacimiento" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Notas</label>
                        <InputTextArea class="form-control" @bind-Value="nuevoContacto.Notas" />
                    </div>

                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">
                            Guardar
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Lista de contactos</h4>

                <div class="mb-3">
                    <label class="form-label">Buscar contacto:</label>

                    <input class="form-control"
                           placeholder="Buscar por nombre, apellido, teléfono o email..."
                           value="@busqueda"
                           @oninput="Buscar" />
                </div>

                @if (contactos.Count == 0)
                {
                    <div class="alert alert-info">
                        @if (string.IsNullOrWhiteSpace(busqueda))
                        {
                            <span>No hay contactos cargados.</span>
                        }
                        else
                        {
                            <span>No se encontraron contactos para la búsqueda "@busqueda".</span>
                        }
                    </div>
                }
                else
                {
                    <div class="list-group"
                     style="max-height: 500px; overflow-y: auto;">

                        @foreach (var contacto in contactos)
                        {
                            <button class="list-group-item list-group-item-action"
                                    @onclick="() => Seleccionar(contacto)">
                                <strong>@contacto.Nombre @contacto.Apellido</strong><br />
                                <small class="text-muted">@contacto.Empresa</small>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Detalle</h4>

                @if (contactoSeleccionado is not null)
                {
                    <p><strong>Nombre:</strong> @contactoSeleccionado.Nombre</p>
                    <p><strong>Apellido:</strong> @contactoSeleccionado.Apellido</p>
                    <p><strong>Teléfono:</strong> @contactoSeleccionado.Telefono</p>
                    <p><strong>Email:</strong> @contactoSeleccionado.Email</p>
                    <p><strong>Empresa:</strong> @contactoSeleccionado.Empresa</p>
                    <p><strong>Cargo:</strong> @contactoSeleccionado.Cargo</p>
                    <p><strong>Dirección:</strong> @contactoSeleccionado.Direccion</p>
                    <p><strong>Fecha de nacimiento:</strong> @contactoSeleccionado.FechaNacimiento?.ToString("dd/MM/yyyy")</p>
                    <p><strong>Notas:</strong> @contactoSeleccionado.Notas</p>

                    <button class="btn btn-outline-primary btn-sm" @onclick="() => Editar(contactoSeleccionado)">
                        Editar
                    </button>

                    <button class="btn btn-outline-danger btn-sm" @onclick="() => Eliminar(contactoSeleccionado)">
                        Eliminar
                    </button>
                }
                else
                {
                    <p class="text-muted">Seleccione un contacto.</p>
                }
            </div>
        </div>
    </div>
</div>
  </div>

@code {
    private List<Contacto> contactos = [];
    private Contacto nuevoContacto = new();
    private Contacto? contactoSeleccionado;

    protected override void OnInitialized()
{
    CargarContactos();
}

private void GuardarContacto()
{
    int idGuardado;

    if (nuevoContacto.Id == 0)
    {
        Db.Contactos.Add(nuevoContacto);
        Db.SaveChanges();

        idGuardado = nuevoContacto.Id;
    }
    else
    {
        var contactoOriginal = Db.Contactos.FirstOrDefault(c => c.Id == nuevoContacto.Id);

        if (contactoOriginal is not null)
        {
            contactoOriginal.Nombre = nuevoContacto.Nombre;
            contactoOriginal.Apellido = nuevoContacto.Apellido;
            contactoOriginal.Telefono = nuevoContacto.Telefono;
            contactoOriginal.Email = nuevoContacto.Email;
            contactoOriginal.Empresa = nuevoContacto.Empresa;
            contactoOriginal.Cargo = nuevoContacto.Cargo;
            contactoOriginal.Direccion = nuevoContacto.Direccion;
            contactoOriginal.FechaNacimiento = nuevoContacto.FechaNacimiento;
            contactoOriginal.Notas = nuevoContacto.Notas;

            Db.SaveChanges();
        }

        idGuardado = nuevoContacto.Id;
    }

    busqueda = "";
    nuevoContacto = new Contacto();

    CargarContactos();

    contactoSeleccionado = contactos.FirstOrDefault(c => c.Id == idGuardado);
}
  private void Editar(Contacto contacto)
{
    nuevoContacto = contacto.Clonar();
}

    private void Eliminar(Contacto contacto)
    {
        Db.Contactos.Remove(contacto);
        Db.SaveChanges();

        contactoSeleccionado = null;
        CargarContactos();
    }

    private void Seleccionar(Contacto contacto)
    {
        contactoSeleccionado = contacto;
    }

    private string busqueda = "";

private void CargarContactos()
{
    Db.ChangeTracker.Clear();

    contactos = Db.Contactos
        .Where(c =>
            c.Nombre.Contains(busqueda) ||
            c.Apellido.Contains(busqueda) ||
            c.Telefono.Contains(busqueda) ||
            c.Email.Contains(busqueda) ||
            c.Empresa.Contains(busqueda) ||
            c.Cargo.Contains(busqueda) ||
            c.Direccion.Contains(busqueda))
        .ToList();
}
private void Buscar(ChangeEventArgs e)
{
    busqueda = e.Value?.ToString() ?? "";
    CargarContactos();
}
}