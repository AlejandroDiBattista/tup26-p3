@page "/contactos"
@rendermode InteractiveServer

@using tp5.Models
@using Microsoft.EntityFrameworkCore
@inject tp5.Data.AgendaDbContext Db

<div class="container py-4">

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h1 class="mb-0">Agenda</h1>
            <p class="text-muted mb-0">Contactos personales y profesionales</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4>Agregar / editar contacto</h4>

            <FormularioContacto Contacto="nuevoContacto"
                    OnGuardar="GuardarContacto" />
        </div>
    </div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Lista de contactos</h4>

                <div class="mb-3">
                    <label class="form-label">Buscar contacto:</label>

                    <input class="form-control"
                           placeholder="Buscar por nombre, apellido, teléfono o email..."
                           value="@busqueda"
                           @oninput="Buscar" />
                </div>

                @if (contactos.Count == 0)
                {
                    <div class="alert alert-info">
                        @if (string.IsNullOrWhiteSpace(busqueda))
                        {
                            <span>No hay contactos cargados.</span>
                        }
                        else
                        {
                            <span>No se encontraron contactos para la búsqueda "@busqueda".</span>
                        }
                    </div>
                }
                else
                {
                    <div class="list-group"
                     style="max-height: 500px; overflow-y: auto;">

                        @foreach (var contacto in contactos)
                    {
                     <ItemContacto Contacto="contacto"
                     OnSeleccionar="() => Seleccionar(contacto)" />
                      }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Detalle</h4>

                <DetalleContacto Contacto="contactoSeleccionado"
                 OnEditar="EditarSeleccionado"
                 OnEliminar="EliminarSeleccionado" />
            </div>
        </div>
    </div>
</div>
  </div>

@code {
    private List<Contacto> contactos = [];
    private Contacto nuevoContacto = new();
    private Contacto? contactoSeleccionado;

    protected override void OnInitialized()
{
    CargarContactos();
}

private void GuardarContacto()
{
    int idGuardado;

    if (nuevoContacto.Id == 0)
    {
        Db.Contactos.Add(nuevoContacto);
        Db.SaveChanges();

        idGuardado = nuevoContacto.Id;
    }
    else
    {
        var contactoOriginal = Db.Contactos.FirstOrDefault(c => c.Id == nuevoContacto.Id);

        if (contactoOriginal is not null)
        {
            contactoOriginal.Nombre = nuevoContacto.Nombre;
            contactoOriginal.Apellido = nuevoContacto.Apellido;
            contactoOriginal.Telefono = nuevoContacto.Telefono;
            contactoOriginal.Email = nuevoContacto.Email;
            contactoOriginal.Empresa = nuevoContacto.Empresa;
            contactoOriginal.Cargo = nuevoContacto.Cargo;
            contactoOriginal.Direccion = nuevoContacto.Direccion;
            contactoOriginal.FechaNacimiento = nuevoContacto.FechaNacimiento;
            contactoOriginal.Notas = nuevoContacto.Notas;

            Db.SaveChanges();
        }

        idGuardado = nuevoContacto.Id;
    }

    busqueda = "";
    nuevoContacto = new Contacto();

    CargarContactos();

    contactoSeleccionado = contactos.FirstOrDefault(c => c.Id == idGuardado);
}
  private void Editar(Contacto contacto)
{
    nuevoContacto = contacto.Clonar();
}

    private void Eliminar(Contacto contacto)
    {
        Db.Contactos.Remove(contacto);
        Db.SaveChanges();

        contactoSeleccionado = null;
        CargarContactos();
    }

    private void Seleccionar(Contacto contacto)
    {
        contactoSeleccionado = contacto;
    }

    private string busqueda = "";

private void CargarContactos()
{
    Db.ChangeTracker.Clear();

    contactos = Db.Contactos
        .Where(c =>
            c.Nombre.Contains(busqueda) ||
            c.Apellido.Contains(busqueda) ||
            c.Telefono.Contains(busqueda) ||
            c.Email.Contains(busqueda) ||
            c.Empresa.Contains(busqueda) ||
            c.Cargo.Contains(busqueda) ||
            c.Direccion.Contains(busqueda))
        .ToList();
}
private void Buscar(ChangeEventArgs e)
{
    busqueda = e.Value?.ToString() ?? "";
    CargarContactos();
}

private void EditarSeleccionado()
{
    if (contactoSeleccionado is not null)
    {
        Editar(contactoSeleccionado);
    }
}

private void EliminarSeleccionado()
{
    if (contactoSeleccionado is not null)
    {
        Eliminar(contactoSeleccionado);
    }
}
}