@page "/contactos"
@rendermode InteractiveServer

@using tp5.Models
@inject tp5.Data.AgendaDbContext Db

<h3>Contactos</h3>

<h4>Agregar contacto</h4>

<EditForm Model="nuevoContacto"
          OnValidSubmit="GuardarContacto"
          FormName="contactoForm">

    <div>
        <label>Nombre:</label>
        <InputText @bind-Value="nuevoContacto.Nombre" />
    </div>

    <div>
        <label>Apellido:</label>
        <InputText @bind-Value="nuevoContacto.Apellido" />
    </div>

    <div>
        <label>Teléfono:</label>
        <InputText @bind-Value="nuevoContacto.Telefono" />
    </div>

    <div>
        <label>Email:</label>
        <InputText @bind-Value="nuevoContacto.Email" />
    </div>
    <div>
    <label>Empresa:</label>
    <InputText @bind-Value="nuevoContacto.Empresa" />
</div>

<div>
    <label>Cargo:</label>
    <InputText @bind-Value="nuevoContacto.Cargo" />
</div>

<div>
    <label>Dirección:</label>
    <InputText @bind-Value="nuevoContacto.Direccion" />
</div>

<div>
    <label>Fecha de nacimiento:</label>
    <InputDate @bind-Value="nuevoContacto.FechaNacimiento" />
</div>

<div>
    <label>Notas:</label>
    <InputTextArea @bind-Value="nuevoContacto.Notas" />
</div>

    <button type="submit">
        Guardar
    </button>

</EditForm>

<hr />

@if (contactos.Count == 0)
{
    <p>No hay contactos cargados.</p>
}
else
{
    <ul>
        @foreach (var contacto in contactos)
        {
            <li>
                @contacto.Nombre @contacto.Apellido
            </li>
        }
    </ul>
}

@code {

    private List<Contacto> contactos = [];

    private Contacto nuevoContacto = new();

    protected override void OnInitialized()
    {
        contactos = Db.Contactos.ToList();
    }

    private void GuardarContacto()
    {
        Db.Contactos.Add(nuevoContacto);

        Db.SaveChanges();

        nuevoContacto = new Contacto();

        contactos = Db.Contactos.ToList();
    }
}