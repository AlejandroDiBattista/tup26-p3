@page "/contactos"
@rendermode InteractiveServer

@using tp5.Models
@inject tp5.Data.AgendaDbContext Db

<h3>Contactos</h3>

<h4>Agregar / editar contacto</h4>

<EditForm Model="nuevoContacto"
          OnValidSubmit="GuardarContacto"
          FormName="contactoForm">
          <DataAnnotationsValidator />
         <ValidationSummary />

    <div>
        <label>Nombre:</label>
        <InputText @bind-Value="nuevoContacto.Nombre" />
    </div>

    <div>
        <label>Apellido:</label>
        <InputText @bind-Value="nuevoContacto.Apellido" />
    </div>

    <div>
        <label>Teléfono:</label>
        <InputText @bind-Value="nuevoContacto.Telefono" />
    </div>

    <div>
        <label>Email:</label>
        <InputText @bind-Value="nuevoContacto.Email" />
    </div>

    <div>
        <label>Empresa:</label>
        <InputText @bind-Value="nuevoContacto.Empresa" />
    </div>

    <div>
        <label>Cargo:</label>
        <InputText @bind-Value="nuevoContacto.Cargo" />
    </div>

    <div>
        <label>Dirección:</label>
        <InputText @bind-Value="nuevoContacto.Direccion" />
    </div>

    <div>
        <label>Fecha de nacimiento:</label>
        <InputDate @bind-Value="nuevoContacto.FechaNacimiento" />
    </div>

    <div>
        <label>Notas:</label>
        <InputTextArea @bind-Value="nuevoContacto.Notas" />
    </div>

    <button type="submit">
        Guardar
    </button>
</EditForm>

<hr />

@if (contactos.Count == 0)
{
    <p>No hay contactos cargados.</p>
}
else
{
    <div style="display: flex; gap: 30px;">
        <div style="width: 300px;">
            <h4>Lista de contactos</h4>

            @foreach (var contacto in contactos)
            {
                <div>
                    <button @onclick="() => Seleccionar(contacto)">
                        @contacto.Nombre @contacto.Apellido
                    </button>
                </div>
            }
        </div>

        <div>
            <h4>Detalle</h4>

            @if (contactoSeleccionado is not null)
            {
                <p><strong>Nombre:</strong> @contactoSeleccionado.Nombre</p>
                <p><strong>Apellido:</strong> @contactoSeleccionado.Apellido</p>
                <p><strong>Teléfono:</strong> @contactoSeleccionado.Telefono</p>
                <p><strong>Email:</strong> @contactoSeleccionado.Email</p>
                <p><strong>Empresa:</strong> @contactoSeleccionado.Empresa</p>
                <p><strong>Cargo:</strong> @contactoSeleccionado.Cargo</p>
                <p><strong>Dirección:</strong> @contactoSeleccionado.Direccion</p>
                <p><strong>Fecha de nacimiento:</strong> @contactoSeleccionado.FechaNacimiento?.ToString("dd/MM/yyyy")</p>
                <p><strong>Notas:</strong> @contactoSeleccionado.Notas</p>

                <button @onclick="() => Editar(contactoSeleccionado)">
                    Editar
                </button>

                <button @onclick="() => Eliminar(contactoSeleccionado)">
                    Eliminar
                </button>
            }
            else
            {
                <p>Seleccione un contacto.</p>
            }
        </div>
    </div>
}

@code {
    private List<Contacto> contactos = [];

    private Contacto nuevoContacto = new();

    protected override void OnInitialized()
    {
        contactos = Db.Contactos.ToList();
    }

    private void GuardarContacto()
    {
        if (nuevoContacto.Id == 0)
        {
            Db.Contactos.Add(nuevoContacto);
        }

        Db.SaveChanges();

        nuevoContacto = new Contacto();
        contactos = Db.Contactos.ToList();
    }

    private void Editar(Contacto contacto)
    {
        nuevoContacto = contacto;
    }

private void Eliminar(Contacto contacto)
{
    Db.Contactos.Remove(contacto);
    Db.SaveChanges();

    contactoSeleccionado = null;
    contactos = Db.Contactos.ToList();
}

  private Contacto? contactoSeleccionado;

  private void Seleccionar(Contacto contacto)
  {
    contactoSeleccionado = contacto;
 }
}