@page "/"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using tp5.Data
@using tp5.Models

@inject AgendaContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

@if (contactos == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="row mt-3">

        <div class="col-md-4 border-end">
            <h3>Contactos</h3>

            <input  class="form-control mb-3"
                    placeholder="Buscar contacto..."
                    @bind="textoBusqueda"
                    @bind:event="oninput" />

            <button class="btn btn-primary mb-3"
                    @onclick="NuevoContacto">
                    Alta de contacto
            </button>   

            <ul class="list-group shadow-sm">

                @foreach (var c in contactosFiltrados)
                {
                    <li class="list-group-item list-group-item-action @(contactoSeleccionado?.Id == c.Id ? "active" : "")"
                        @onclick="() => Seleccionar(c)"
                        style="cursor:pointer">
                        <div>
                        @c.Apellido, @c.Nombre
                        </div>
                        <small>@c.Telefono | @c.Email</small>
                    </li>
                }

            </ul>
        </div>

        <div class="col-md-8 ps-4">
            <div class="card">
                <div class="card-body">

                @if (modoEdicion)
                {
                    <h2>@(contactoEditando.Id == 0 ? "Nuevo contacto" : "Editar contacto")</h2>

                    <div class="mb-2">
                        <label>Legajo</label>
                        <input class="form-control"
                            @bind="contactoEditando.Legajo" />
                    </div>

                    <div class="mb-2">
                        <label>Nombre</label>
                        <input class="form-control"
                            @bind="contactoEditando.Nombre" />
                    </div>

                    <div class="mb-2">
                        <label>Apellido</label>
                        <input class="form-control"
                            @bind="contactoEditando.Apellido" />
                    </div>

                    <div class="mb-2">
                        <label>Teléfono</label>
                        <input class="form-control"
                            @bind="contactoEditando.Telefono" />
                    </div>

                    <div class="mb-2">
                        <label>Email</label>
                        <input class="form-control"
                            @bind="contactoEditando.Email" />
                    </div>

                    <div class="mb-2">
                        <label>Empresa</label>
                        <input class="form-control"
                            @bind="contactoEditando.Empresa" />
                    </div>

                    <div class="mb-2">
                        <label>Cargo</label>
                        <input class="form-control"
                            @bind="contactoEditando.Cargo" />
                    </div>

                    <div class="mb-2">
                        <label>Dirección</label>
                        <input class="form-control"
                            @bind="contactoEditando.Direccion" />
                    </div>

                    <div class="mb-2">
                        <label>Notas</label>
                        <textarea class="form-control"
                                @bind="contactoEditando.Notas"></textarea>
                    </div>

                    <button class="btn btn-success"
                            @onclick="GuardarContacto">
                        Guardar
                    </button>

                    <button class="btn btn-secondary ms-2"
                            @onclick="CancelarEdicion">
                        Cancelar
                    </button>
                }
                else if (contactoSeleccionado != null)
                {
                    <h2>@contactoSeleccionado.Nombre @contactoSeleccionado.Apellido</h2>

                    <hr>

                    <p><b>Legajo:</b> @contactoSeleccionado.Legajo</p>

                    <p><b>Teléfono:</b> @contactoSeleccionado.Telefono</p>

                    <p><b>Email:</b> @contactoSeleccionado.Email</p>

                    <p><b>Empresa:</b> @contactoSeleccionado.Empresa</p>

                    <p><b>Cargo:</b> @contactoSeleccionado.Cargo</p>

                    <p><b>Dirección:</b> @contactoSeleccionado.Direccion</p>

                    <p><b>Fecha Nacimiento:</b> @contactoSeleccionado.FechaNacimiento</p>

                    <p><b>Notas:</b> @contactoSeleccionado.Notas</p>

                    <button class="btn btn-warning"
                            @onclick="EditarContacto">
                        Modificar Contacto
                    </button>

                    <button class="btn btn-danger ms-2"
                            @onclick="EliminarContacto">
                        Baja de contactos
                    </button>
                }

                </div>

            </div>
        
        </div>

    </div>   
}

@code {

    List<Contacto>? contactos;

    Contacto? contactoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        contactos = await Db.Contactos
            .OrderBy(c => c.Apellido)
            .ToListAsync();

        contactoSeleccionado = contactos.FirstOrDefault();
    }

    void Seleccionar(Contacto contacto)
    {
        contactoSeleccionado = contacto;
    }

    void NuevoContacto()
    {
        contactoEditando = new Contacto();
        modoEdicion = true;
    }

    void EditarContacto()
    {
        if (contactoSeleccionado == null)
            return;

        contactoEditando = new Contacto
        {
            Id = contactoSeleccionado.Id,
            Legajo = contactoSeleccionado.Legajo,
            Nombre = contactoSeleccionado.Nombre,
            Apellido = contactoSeleccionado.Apellido,
            Telefono = contactoSeleccionado.Telefono,
            Email = contactoSeleccionado.Email,
            Empresa = contactoSeleccionado.Empresa,
            Cargo = contactoSeleccionado.Cargo,
            Direccion = contactoSeleccionado.Direccion,
            FechaNacimiento = contactoSeleccionado.FechaNacimiento,
            Notas = contactoSeleccionado.Notas
        };

        modoEdicion = true;
    }

    async Task EliminarContacto()
    {
        if (contactoSeleccionado == null)
            return;

        Db.Contactos.Remove(contactoSeleccionado);

        await Db.SaveChangesAsync();

        contactos = await Db.Contactos
            .OrderBy(c => c.Apellido)
            .ToListAsync();

        contactoSeleccionado = contactos.FirstOrDefault();
    }

    async Task GuardarContacto()
    {
        if (contactoEditando.Id == 0)
        {
            Db.Contactos.Add(contactoEditando);
        }
        else
        {
            var contactoExistente = await Db.Contactos.FindAsync(contactoEditando.Id);

            if (contactoExistente != null)
            { 
                contactoExistente.Legajo = contactoEditando.Legajo;
                contactoExistente.Nombre = contactoEditando.Nombre;
                contactoExistente.Apellido = contactoEditando.Apellido;
                contactoExistente.Telefono = contactoEditando.Telefono;
                contactoExistente.Email = contactoEditando.Email;
                contactoExistente.Empresa = contactoEditando.Empresa;
                contactoExistente.Cargo = contactoEditando.Cargo;
                contactoExistente.Direccion = contactoEditando.Direccion;
                contactoExistente.FechaNacimiento = contactoEditando.FechaNacimiento;
                contactoExistente.Notas = contactoEditando.Notas;
            }
        }

        await Db.SaveChangesAsync();

        contactos = await Db.Contactos
            .OrderBy(c => c.Apellido)
            .ToListAsync();

        contactoSeleccionado = contactos
            .FirstOrDefault(c => c.Id == contactoEditando.Id);

        modoEdicion = false;
    }

    void CancelarEdicion()
    {
        modoEdicion = false;
    }

    bool modoEdicion = false;

    Contacto contactoEditando = new();

    string textoBusqueda = "";

    IEnumerable<Contacto> contactosFiltrados =>
        contactos?.Where(c =>
            string.IsNullOrWhiteSpace(textoBusqueda) ||
            c.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            c.Apellido.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            c.Legajo.ToString().Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Contacto>();
}
