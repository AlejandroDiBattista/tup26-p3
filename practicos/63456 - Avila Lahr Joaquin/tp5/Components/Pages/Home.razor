@page "/"
@rendermode InteractiveServer
@using tp5.Models
@using tp5.Services
@inject ServicioContacto Servicio

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="agenda">

    <div class="panel-lista">
        <input type="text" placeholder="Buscar..." @bind="busqueda" />
        <button class="btn-azul" @onclick="Buscar">Buscar</button>
        <button class="btn-azul" @onclick="NuevoContacto">+ Nuevo</button>
<div class="lista-contactos">
        @foreach (var c in contactos)
        {
            <div class="item-contacto @(seleccionado?.Id == c.Id ? "seleccionado" : "")"
                 @onclick="() => Seleccionar(c)">
                <strong>@c.Apellido, @c.Nombre</strong>
                <small>@c.Email</small>
            </div>
        }
 </div>

        <div class="pie-lista">@contactos.Count contacto(s)</div>
        <div class="pie-lista">@contactos.Count contacto(s)</div>
    </div>

    <div class="panel-detalle">

        @if (modoFormulario && editando != null)
        {
            <h3>@(editando.Id == 0 ? "Nuevo contacto" : "Editar contacto")</h3>

            <p><strong>Datos obligatorios</strong></p>

            <div class="fila-form">
                <div class="campo">
                    <label>Nombre *</label>
                    <input type="text" value="@editando.Nombre" @onchange="e => editando.Nombre = e.Value?.ToString() ?? string.Empty" placeholder="Nombre" />
                </div>
                <div class="campo">
                    <label>Apellido *</label>
                    <input type="text" value="@editando.Apellido" @onchange="e => editando.Apellido = e.Value?.ToString() ?? string.Empty" placeholder="Apellido" />
                </div>
            </div>

            <div class="fila-form">
                <div class="campo">
                    <label>Teléfono *</label>
                    <input type="text" value="@editando.Telefono" @onchange="e => editando.Telefono = e.Value?.ToString() ?? string.Empty" placeholder="Teléfono" />
                </div>
                <div class="campo">
                    <label>Email *</label>
                    <input type="text" value="@editando.Email" @onchange="e => editando.Email = e.Value?.ToString() ?? string.Empty" placeholder="Email" />
                </div>
            </div>

            <p><strong>Datos opcionales</strong></p>

            <div class="fila-form">
                <div class="campo">
                    <label>Empresa</label>
                    <input type="text" value="@editando.Empresa" @onchange="e => editando.Empresa = e.Value?.ToString() ?? string.Empty" placeholder="Empresa" />
                </div>
                <div class="campo">
                    <label>Cargo</label>
                    <input type="text" value="@editando.Cargo" @onchange="e => editando.Cargo = e.Value?.ToString() ?? string.Empty" placeholder="Cargo" />
                </div>
            </div>

            <div class="fila-form">
                <div class="campo">
                    <label>Dirección</label>
                    <input type="text" value="@editando.Direccion" @onchange="e => editando.Direccion = e.Value?.ToString() ?? string.Empty" placeholder="Dirección" />
                </div>
                <div class="campo">
                    <label>Fecha de nacimiento</label>
                    <input type="date" value="@editando.FechaNacimiento?.ToString("yyyy-MM-dd")" @onchange="e => editando.FechaNacimiento = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                </div>
            </div>

            <div class="fila-form">
                <div class="campo">
                    <label>Notas</label>
                    <textarea @onchange="e => editando.Notas = e.Value?.ToString() ?? string.Empty" rows="3" placeholder="Notas...">@editando.Notas</textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorForm))
            {
                <p style="color:red;">@errorForm</p>
            }

            <button class="btn-gris" @onclick="Cancelar">Cancelar</button>
            <button class="btn-azul" @onclick="Guardar">Guardar</button>
        }
        else if (seleccionado != null)
        {
            <h3>@seleccionado.Nombre @seleccionado.Apellido</h3>

            <p><strong>Teléfono:</strong> @seleccionado.Telefono</p>
            <p><strong>Email:</strong> @seleccionado.Email</p>

            @if (!string.IsNullOrEmpty(seleccionado.Empresa))
            {
                <p><strong>Empresa:</strong> @seleccionado.Empresa</p>
            }
            @if (!string.IsNullOrEmpty(seleccionado.Cargo))
            {
                <p><strong>Cargo:</strong> @seleccionado.Cargo</p>
            }
            @if (!string.IsNullOrEmpty(seleccionado.Direccion))
            {
                <p><strong>Dirección:</strong> @seleccionado.Direccion</p>
            }
            @if (seleccionado.FechaNacimiento.HasValue)
            {
                <p><strong>Fecha de nacimiento:</strong> @seleccionado.FechaNacimiento.Value.ToString("dd/MM/yyyy")</p>
            }
            @if (!string.IsNullOrEmpty(seleccionado.Notas))
            {
                <p><strong>Notas:</strong> @seleccionado.Notas</p>
            }

            <button class="btn-azul" @onclick="Editar">Editar</button>
            <button class="btn-rojo" @onclick="Eliminar">Eliminar</button>
        }
        else
        {
            <p>Seleccioná un contacto o creá uno nuevo.</p>
        }

    </div>

</div>

@code {
    private List<Contacto> contactos = [];
    private Contacto? seleccionado;
    private Contacto? editando;
    private string busqueda = "";
    private bool modoFormulario = false;
    private string errorForm = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarContactos();
    }

    private async Task CargarContactos()
    {
        contactos = await Servicio.ObtenerTodosAsync(busqueda);
    }

    private async Task Buscar()
    {
        await CargarContactos();
    }

    private void Seleccionar(Contacto c)
    {
        seleccionado = c;
        modoFormulario = false;
        errorForm = "";
    }

    private void NuevoContacto()
    {
        editando = new Contacto();
        seleccionado = null;
        modoFormulario = true;
        errorForm = "";
    }

    private void Editar()
    {
        if (seleccionado == null) return;
        editando = new Contacto
        {
            Id = seleccionado.Id,
            Nombre = seleccionado.Nombre,
            Apellido = seleccionado.Apellido,
            Telefono = seleccionado.Telefono,
            Email = seleccionado.Email,
            Empresa = seleccionado.Empresa,
            Cargo = seleccionado.Cargo,
            Direccion = seleccionado.Direccion,
            FechaNacimiento = seleccionado.FechaNacimiento,
            Notas = seleccionado.Notas
        };
        modoFormulario = true;
        errorForm = "";
    }

    private void Cancelar()
    {
        modoFormulario = false;
        editando = null;
        errorForm = "";
    }

    private async Task Guardar()
    {
        if (editando == null) return;

        if (string.IsNullOrWhiteSpace(editando.Nombre) ||
            string.IsNullOrWhiteSpace(editando.Apellido) ||
            string.IsNullOrWhiteSpace(editando.Telefono) ||
            string.IsNullOrWhiteSpace(editando.Email))
        {
            errorForm = "Nombre, Apellido, Teléfono y Email son obligatorios.";
            return;
        }

        if (editando.Id == 0)
        {
            var nuevo = await Servicio.CrearAsync(editando);
            await CargarContactos();
            seleccionado = contactos.FirstOrDefault(c => c.Id == nuevo.Id);
        }
        else
        {
            await Servicio.ActualizarAsync(editando);
            await CargarContactos();
            seleccionado = contactos.FirstOrDefault(c => c.Id == editando.Id);
        }

        modoFormulario = false;
        editando = null;
    }

    private async Task Eliminar()
    {
        if (seleccionado == null) return;
        await Servicio.EliminarAsync(seleccionado.Id);
        seleccionado = null;
        await CargarContactos();
    }
}