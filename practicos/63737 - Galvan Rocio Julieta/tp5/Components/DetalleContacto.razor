@using tp5.Models

@if (Contacto is not null)
{
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h3 class="mb-1">
                <i class="bi bi-person-vcard me-2"></i>
                @Contacto.Nombre @Contacto.Apellido
            </h3>

            <p class="text-primary mb-0">@Contacto.Empresa</p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-warning btn-sm"
                    @onclick="OnEditar">
                <i class="bi bi-pencil me-1"></i>
                Editar
            </button>

            <button class="btn btn-outline-danger btn-sm"
                    @onclick="OnEliminar">
                <i class="bi bi-trash me-1"></i>
                Eliminar
            </button>
        </div>
    </div>

    <hr />

    <p>
        <strong><i class="bi bi-envelope me-2"></i>Email:</strong>
        @Contacto.Email
    </p>

    <p>
        <strong><i class="bi bi-telephone me-2"></i>Teléfono:</strong>
        @Contacto.Telefono
    </p>

    <p>
        <strong><i class="bi bi-building me-2"></i>Empresa:</strong>
        @Contacto.Empresa
    </p>

    <p>
        <strong><i class="bi bi-briefcase me-2"></i>Cargo:</strong>
        @Contacto.Cargo
    </p>

    <p>
        <strong><i class="bi bi-geo-alt me-2"></i>Dirección:</strong>
        @Contacto.Direccion
    </p>

    <p>
        <strong><i class="bi bi-calendar me-2"></i>Fecha de nacimiento:</strong>
        @Contacto.FechaNacimiento?.ToString("dd/MM/yyyy")
    </p>

    <p>
        <strong><i class="bi bi-journal-text me-2"></i>Notas:</strong>
        @Contacto.Notas
    </p>
}
else
{
    <p class="text-muted">Seleccione un contacto.</p>
}

@code {
    [Parameter]
    public Contacto? Contacto { get; set; }

    [Parameter]
    public EventCallback OnEditar { get; set; }

    [Parameter]
    public EventCallback OnEliminar { get; set; }
}