@using tp5.Models

<div class="list-group">
    @foreach (Contacto contacto in Contactos)
    {
        <button
            type="button"
            class="@ObtenerClaseItem(contacto.Id)"
            @onclick="() => OnContactoSeleccionado.InvokeAsync(contacto)"
            @key="contacto.Id">
            <div class="d-flex w-100 justify-content-between">
                <h6 class="mb-0">@contacto.Apellido, @contacto.Nombre</h6>
                <small>@contacto.Telefono</small>
            </div>
            <small>@contacto.Email</small>
        </button>
    }
</div>

@if (Contactos.Count == 0)
{
    <div class="text-center text-muted py-4">
        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
        <span>No se encontraron contactos.</span>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<Contacto> Contactos { get; set; } = [];

    [Parameter]
    public int? ContactoIdSeleccionado { get; set; }

    [Parameter]
    public EventCallback<Contacto> OnContactoSeleccionado { get; set; }

    private string ObtenerClaseItem(int contactoId)
    {
        string activo = contactoId == ContactoIdSeleccionado ? " active" : "";
        return $"list-group-item list-group-item-action{activo}";
    }
}
