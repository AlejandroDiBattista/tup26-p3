@using System.ComponentModel.DataAnnotations
@using tp5.Models

<EditForm Model="Contacto" OnValidSubmit="GuardarAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3" />

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-person-plus me-2"></i>
                @(Contacto.EsNuevo ? "Nuevo contacto" : "Editar contacto")
            </h5>
            <div>
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm ms-1" @onclick="OnCancelar">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nombre *</label>
                    <InputText class="form-control" @bind-Value="Contacto.Nombre" />
                    <ValidationMessage For="@(() => Contacto.Nombre)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Apellido *</label>
                    <InputText class="form-control" @bind-Value="Contacto.Apellido" />
                    <ValidationMessage For="@(() => Contacto.Apellido)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Teléfono *</label>
                    <InputText class="form-control" @bind-Value="Contacto.Telefono" />
                    <ValidationMessage For="@(() => Contacto.Telefono)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Correo electrónico *</label>
                    <InputText class="form-control" @bind-Value="Contacto.Email" />
                    <ValidationMessage For="@(() => Contacto.Email)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Empresa</label>
                    <InputText class="form-control" @bind-Value="Contacto.Empresa" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Cargo</label>
                    <InputText class="form-control" @bind-Value="Contacto.Cargo" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Dirección</label>
                    <InputText class="form-control" @bind-Value="Contacto.Direccion" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Fecha de nacimiento</label>
                    <InputDate class="form-control" @bind-Value="Contacto.FechaNacimiento" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Notas</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="Contacto.Notas" />
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public Contacto Contacto { get; set; } = default!;

    [Parameter]
    public EventCallback<Contacto> OnGuardar { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    private async Task GuardarAsync()
    {
        await OnGuardar.InvokeAsync(Contacto);
    }
}
