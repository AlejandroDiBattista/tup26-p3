@page "/"
@rendermode InteractiveServer
@inject ContactoService ContactoService

<PageTitle>TP5: AgendaWeb</PageTitle>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="status-toast @(statusIsError ? "error" : null)" role="status" aria-live="polite">
        <i class="bi @(statusIsError ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        @statusMessage
        <button type="button" aria-label="Cerrar mensaje" @onclick="DismissStatus">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>
}

<main class="agenda-shell @(isMobileDetailVisible ? "mobile-detail-visible" : null)">
    <ContactList Contacts="contacts"
                 SelectedId="selectedId"
                 SearchText="@searchText"
                 IsLoading="isLoading"
                 OnSelect="SelectContactAsync"
                 OnSearch="SearchAsync"
                 OnCreate="StartCreate" />

    <div class="detail-area">
        <button class="mobile-back" type="button" @onclick="ShowMobileList">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a contactos
        </button>

        @if (editor is not null)
        {
            <ContactForm Model="editor" OnSave="SaveAsync" OnCancel="CancelEdit" />
        }
        else if (selectedContact is not null)
        {
            <ContactDetail Contact="selectedContact" OnEdit="StartEdit" OnDelete="RequestDelete" />
        }
        else
        {
            <section class="detail-placeholder" aria-live="polite">
                <i class="bi bi-person-vcard" aria-hidden="true"></i>
                <h2>Elegí un contacto</h2>
                <p>Seleccioná una persona de la lista para consultar todos sus datos.</p>
            </section>
        }
    </div>
</main>

@if (showDeleteConfirmation && selectedContact is not null)
{
    <div class="dialog-backdrop" @onclick="CancelDelete">
        <section class="confirm-dialog"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="delete-title"
                 aria-describedby="delete-description"
                 @onclick:stopPropagation="true">
            <span class="danger-icon" aria-hidden="true"><i class="bi bi-trash3"></i></span>
            <h2 id="delete-title">Eliminar contacto</h2>
            <p id="delete-description">
                ¿Querés eliminar a <strong>@selectedContact.Nombre @selectedContact.Apellido</strong>?
                Esta acción no se puede deshacer.
            </p>
            <div class="dialog-actions">
                <button class="btn btn-outline-secondary" type="button" @onclick="CancelDelete">Cancelar</button>
                <button class="btn btn-danger" type="button" @onclick="DeleteAsync">Eliminar definitivamente</button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<Contacto> contacts = [];
    private int? selectedId;
    private Contacto? selectedContact;
    private Contacto? editor;
    private string searchText = "";
    private bool isLoading = true;
    private bool showDeleteConfirmation;
    private bool statusIsError;
    private bool isMobileDetailVisible;
    private string statusMessage = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        contacts = await ContactoService.ListarAsync(searchText);
        selectedId = contacts.Any(contact => contact.Id == selectedId)
            ? selectedId
            : contacts.FirstOrDefault()?.Id;
        selectedContact = selectedId is int id
            ? await ContactoService.ObtenerAsync(id)
            : null;
        isLoading = false;
    }

    private async Task SelectContactAsync(int id)
    {
        editor = null;
        selectedId = id;
        selectedContact = await ContactoService.ObtenerAsync(id);
        isMobileDetailVisible = true;
    }

    private async Task SearchAsync(string value)
    {
        searchText = value;
        await LoadAsync();
    }

    private void StartCreate()
    {
        selectedId = null;
        selectedContact = null;
        editor = new Contacto();
        isMobileDetailVisible = true;
    }

    private void StartEdit()
    {
        if (selectedContact is not null)
        {
            editor = CopyContact(selectedContact);
        }
    }

    private void ShowMobileList() => isMobileDetailVisible = false;

    private async Task SaveAsync(Contacto contacto)
    {
        try
        {
            var isNew = contacto.Id == 0;
            selectedId = isNew ? await ContactoService.CrearAsync(contacto) : contacto.Id;

            if (!isNew && !await ContactoService.ActualizarAsync(contacto))
            {
                selectedId = null;
                ShowStatus("El contacto ya no existe.", isError: true);
            }
            else
            {
                ShowStatus(isNew ? "Contacto creado correctamente." : "Cambios guardados correctamente.");
            }

            editor = null;
            await LoadAsync();
        }
        catch (Exception)
        {
            ShowStatus("No se pudieron guardar los cambios. Intentá nuevamente.", isError: true);
        }
    }

    private async Task CancelEdit()
    {
        editor = null;
        if (selectedContact is null && contacts.Count > 0)
        {
            await SelectContactAsync(contacts[0].Id);
        }
    }

    private void RequestDelete()
    {
        showDeleteConfirmation = selectedContact is not null;
    }

    private void CancelDelete() => showDeleteConfirmation = false;

    private async Task DeleteAsync()
    {
        if (selectedContact is null)
        {
            return;
        }

        try
        {
            var deleted = await ContactoService.EliminarAsync(selectedContact.Id);
            showDeleteConfirmation = false;
            selectedId = null;
            selectedContact = null;
            ShowStatus(deleted ? "Contacto eliminado." : "El contacto ya no existía.", isError: !deleted);
            await LoadAsync();
        }
        catch (Exception)
        {
            showDeleteConfirmation = false;
            ShowStatus("No se pudo eliminar el contacto. Intentá nuevamente.", isError: true);
        }
    }

    private void ShowStatus(string message, bool isError = false)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    private void DismissStatus() => statusMessage = "";

    private static Contacto CopyContact(Contacto source) => new()
    {
        Id = source.Id,
        Nombre = source.Nombre,
        Apellido = source.Apellido,
        Telefono = source.Telefono,
        Email = source.Email,
        Empresa = source.Empresa,
        Cargo = source.Cargo,
        Direccion = source.Direccion,
        FechaNacimiento = source.FechaNacimiento,
        Notas = source.Notas
    };
}
