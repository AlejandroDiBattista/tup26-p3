@page "/nuevo"
@rendermode InteractiveServer

@using tp5.Models
@using tp5.Datos

@inject AgendaContext Db
@inject NavigationManager Navigation

<EditForm Model="nuevo" OnValidSubmit="Guardar">
<DataAnnotationsValidator/>
<div>
    <h1 class="bi bi-person-lines-fill"> Agenda de contactos </h1>
</div>
<div class="container">
<div class="row">
<div class="col-md-6">
<h3 class="bi bi-person-plus-fill">Nuevo Contacto</h3>
<div class="mb-3">
    <label>Nombre</label>
    <input class="form-control" @bind="nuevo.Nombre" />
    <ValidationMessage For="() => nuevo.Nombre"/>
</div>
<div class="mb-3">
    <label>Apellido</label>
    <input class="form-control" @bind="nuevo.Apellido"/>
    <ValidationMessage For="() => nuevo.Apellido"/>
</div>
<div class="mb-3">
    <label>Telefono</label>
    <input class="form-control" @bind="nuevo.Telefono"/>
    <ValidationMessage For="() => nuevo.Telefono"/>
</div>
<div class="mb-3">
    <label>Email</label>
    <input class="form-control" @bind="nuevo.Email"/>
    <ValidationMessage For="() => nuevo.Email"/>
</div>
<div class="mb-3">
    <label>Empresa</label>
    <input class="form-control" @bind="nuevo.Empresa"/>
</div>
<div class="mb-3">
    <label>Cargo</label>
    <input class="form-control" @bind="nuevo.Cargo"/>
</div>
<div class="mb-3">
    <label>Direccion</label>
    <input class="form-control" @bind="nuevo.Direccion"/>
</div>
<div class="mb-3">
    <label>Notas</label>
    <textarea class="form-control" @bind="nuevo.Notas"> </textarea>
</div>

<button type="submit" class="btn btn-info me-2"><i class="bi bi-check-circle-fill">Guardar</i></button>
<a href="/" class="btn btn-secondary"><i class="bi bi-x-circle">Cancelar</i></a>
</div>
</div>
</div>
</EditForm>

@code {
    Contacto nuevo = new();
    async Task Guardar()
    {
        Db.Contactos.Add(nuevo);
        await Db.SaveChangesAsync();
        Navigation.NavigateTo("/");
    }

}