@page "/"
@inject AgendaContext Db
@using Microsoft.EntityFrameworkCore

<div class="container-fluid mt-4">
    <h2 class="text-center mb-4">TP5: AgendaWeb</h2>

    <div class="row">
        <div class="col-md-5 border-end">
            <div class="mb-3">
                <input type="text" class="form-control" placeholder="Buscar por nombre o apellido..." 
                       @bind="textoBuscar" @bind:event="oninput" @onkeyup="Filtrar" />
            </div>

            <div class="list-group" style="max-height: 500px; overflow-y: auto;">
                @if (contactosFiltrados == null)
                {
                    <p class="text-center">Cargando la agenda...</p>
                }
                else if (!contactosFiltrados.Any())
                {
                    <p class="text-center text-muted">No se encontraron contactos.</p>
                }
                else
                {
                    @foreach (var c in contactosFiltrados)
                    {
                        <button type="button" class="list-group-item list-group-item-action @(contactoSeleccionado?.Id == c.Id ? "active" : "")"
                                @onclick="() => Seleccionar(c)">
                            <strong>@c.Apellido, @c.Nombre</strong>
                            <br />
                            <small class="text-muted">@c.Telefono</small>
                        </button>
                    }
                }
            </div>
        </div>

        <div class="col-md-7 ps-4">
            @if (contactoSeleccionado != null)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h3 class="card-title text-primary mb-3">@contactoSeleccionado.Nombre @contactoSeleccionado.Apellido</h3>
                        <hr />
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <strong>Teléfono:</strong> <p>@contactoSeleccionado.Telefono</p>
                            </div>
                            <div class="col-sm-6">
                                <strong>Correo Electrónico:</strong> <p>@contactoSeleccionado.CorreoElectronico</p>
                            </div>
                            <div class="col-sm-6">
                                <strong>Empresa:</strong> <p>@(string.IsNullOrEmpty(contactoSeleccionado.Empresa) ? "---" : contactoSeleccionado.Empresa)</p>
                            </div>
                            <div class="col-sm-6">
                                <strong>Cargo:</strong> <p>@(string.IsNullOrEmpty(contactoSeleccionado.Cargo) ? "---" : contactoSeleccionado.Cargo)</p>
                            </div>
                            <div class="col-sm-12">
                                <strong>Dirección:</strong> <p>@(string.IsNullOrEmpty(contactoSeleccionado.Direccion) ? "---" : contactoSeleccionado.Direccion)</p>
                            </div>
                            <div class="col-sm-6">
                                <strong>Fecha de Nacimiento:</strong> <p>@(contactoSeleccionado.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "---")</p>
                            </div>
                            <div class="col-sm-12">
                                <strong>Notas:</strong> <p class="bg-light p-2 rounded">@(string.IsNullOrEmpty(contactoSeleccionado.Notas) ? "Sin notas adicionales." : contactoSeleccionado.Notas)</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center text-muted mt-5">
                    <i class="bi bi-person-lines-fill" style="font-size: 3rem;"></i>
                    <p class="mt-2">Selecciona un contacto de la lista para ver su perfil completo.</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Contacto> todosLosContactos = new();
    private List<Contacto> contactosFiltrados = new();
    private Contacto? contactoSeleccionado;
    private string textoBuscar = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarLista();
    }

    private async Task CargarLista()
    {
        todosLosContactos = await Db.Contactos.OrderBy(c => c.Apellido).ToListAsync();
        Filtrar();
    }

    private void Filtrar()
    {
        if (string.IsNullOrWhiteSpace(textoBuscar))
        {
            contactosFiltrados = todosLosContactos.ToList();
        }
        else
        {
            var txt = textoBuscar.ToLower();
            contactosFiltrados = todosLosContactos.Where(c => 
                c.Nombre.ToLower().Contains(txt) || 
                c.Apellido.ToLower().Contains(txt)).ToList();
        }
    }

    private void Seleccionar(Contacto c)
    {
        contactoSeleccionado = c;
    }
} 