@* Un único formulario sirve para alta y edición. Los atributos name,
   autocomplete y los tipos semánticos facilitan teclado móvil y autofill. *@
<article class="contact-form-panel">
    <header class="form-header">
        <span class="detail-avatar" aria-hidden="true">
            <i class="bi @(EsNuevo ? "bi-person-plus" : "bi-person-gear")"></i>
        </span>
        <div>
            <span class="eyebrow">@(EsNuevo ? "Nuevo registro" : "Actualización")</span>
            <h2>@(EsNuevo ? "Crear contacto" : "Editar contacto")</h2>
            <p>@(EsNuevo
                ? "Completá los datos obligatorios para agregarlo a la agenda."
                : $"Modificá la información de {Modelo.Nombre} {Modelo.Apellido}.")</p>
        </div>
    </header>

    <EditForm Model="Modelo"
              FormName="contacto"
              OnValidSubmit="GuardarAsync"
              class="contact-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />

        <fieldset disabled="@Guardando">
            <legend>Datos personales</legend>
            <div class="form-grid">
                <div class="field-group">
                    <label for="nombre">Nombre <span aria-hidden="true">*</span></label>
                    <input id="nombre"
                           name="nombre"
                           class="form-control"
                           autocomplete="given-name"
                           maxlength="80"
                           @bind="Modelo.Nombre"
                           @bind:event="oninput" />
                    <ValidationMessage For="() => Modelo.Nombre" />
                </div>
                <div class="field-group">
                    <label for="apellido">Apellido <span aria-hidden="true">*</span></label>
                    <input id="apellido"
                           name="apellido"
                           class="form-control"
                           autocomplete="family-name"
                           maxlength="80"
                           @bind="Modelo.Apellido"
                           @bind:event="oninput" />
                    <ValidationMessage For="() => Modelo.Apellido" />
                </div>
                <div class="field-group">
                    <label for="telefono">Teléfono <span aria-hidden="true">*</span></label>
                    <input id="telefono"
                           name="telefono"
                           type="tel"
                           inputmode="tel"
                           class="form-control"
                           autocomplete="tel"
                           maxlength="40"
                           @bind="Modelo.Telefono"
                           @bind:event="oninput" />
                    <ValidationMessage For="() => Modelo.Telefono" />
                </div>
                <div class="field-group">
                    <label for="email">Correo electrónico <span aria-hidden="true">*</span></label>
                    <input id="email"
                           name="email"
                           type="email"
                           inputmode="email"
                           class="form-control"
                           autocomplete="email"
                           maxlength="160"
                           @bind="Modelo.Email"
                           @bind:event="oninput" />
                    <ValidationMessage For="() => Modelo.Email" />
                </div>
                <div class="field-group">
                    <label for="fecha-nacimiento">Fecha de nacimiento</label>
                    <InputDate id="fecha-nacimiento"
                               name="fechaNacimiento"
                               class="form-control"
                               @bind-Value="Modelo.FechaNacimiento" />
                    <ValidationMessage For="() => Modelo.FechaNacimiento" />
                </div>
            </div>
        </fieldset>

        <fieldset disabled="@Guardando">
            <legend>Información profesional</legend>
            <div class="form-grid">
                <div class="field-group">
                    <label for="empresa">Empresa</label>
                    <input id="empresa"
                           name="empresa"
                           class="form-control"
                           autocomplete="organization"
                           maxlength="120"
                           @bind="Modelo.Empresa"
                           @bind:event="oninput" />
                    <ValidationMessage For="() => Modelo.Empresa" />
                </div>
                <div class="field-group">
                    <label for="cargo">Cargo</label>
                    <input id="cargo"
                           name="cargo"
                           class="form-control"
                           autocomplete="organization-title"
                           maxlength="120"
                           @bind="Modelo.Cargo"
                           @bind:event="oninput" />
                    <ValidationMessage For="() => Modelo.Cargo" />
                </div>
            </div>
        </fieldset>

        <fieldset disabled="@Guardando">
            <legend>Información adicional</legend>
            <div class="form-grid form-grid-single">
                <div class="field-group">
                    <label for="direccion">Dirección</label>
                    <textarea id="direccion"
                              name="direccion"
                              class="form-control"
                              autocomplete="street-address"
                              maxlength="240"
                              rows="2"
                              @bind="Modelo.Direccion"
                              @bind:event="oninput"></textarea>
                    <ValidationMessage For="() => Modelo.Direccion" />
                </div>
                <div class="field-group">
                    <label for="notas">Notas</label>
                    <textarea id="notas"
                              name="notas"
                              class="form-control"
                              maxlength="1000"
                              rows="4"
                              @bind="Modelo.Notas"
                              @bind:event="oninput"></textarea>
                    <ValidationMessage For="() => Modelo.Notas" />
                </div>
            </div>
        </fieldset>

        <p class="required-hint"><span aria-hidden="true">*</span> Campos obligatorios</p>

        <footer class="form-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@Guardando"
                    @onclick="AlCancelar">
                Cancelar
            </button>
            <button type="submit" class="btn btn-primary" disabled="@Guardando">
                @if (Guardando)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Guardando…</span>
                }
                else
                {
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    <span>@(EsNuevo ? "Crear contacto" : "Guardar cambios")</span>
                }
            </button>
        </footer>
    </EditForm>
</article>

@code {
    /// <summary>Copia editable administrada por la página contenedora.</summary>
    [Parameter, EditorRequired]
    public Contacto Modelo { get; set; } = default!;

    /// <summary>Distingue el texto y el propósito del alta respecto de la edición.</summary>
    [Parameter]
    public bool EsNuevo { get; set; }

    /// <summary>Bloquea el formulario después de un envío válido para evitar duplicados.</summary>
    [Parameter]
    public bool Guardando { get; set; }

    /// <summary>Entrega el modelo validado a la página para persistirlo.</summary>
    [Parameter]
    public EventCallback<Contacto> AlGuardar { get; set; }

    /// <summary>Descarta la copia editable y vuelve al detalle.</summary>
    [Parameter]
    public EventCallback AlCancelar { get; set; }

    private Task GuardarAsync() => AlGuardar.InvokeAsync(Modelo);
}
