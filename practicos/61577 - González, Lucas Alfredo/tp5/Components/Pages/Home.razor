@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AgendaService Agenda

<PageTitle>Agenda de contactos</PageTitle>

<main class="agenda-shell">
    <header class="agenda-header">
        <div>
            <span class="eyebrow">TP5 · Programación III</span>
            <h1>Agenda</h1>
            <p>Contactos personales y profesionales en un solo lugar.</p>
        </div>
        <button type="button" class="btn btn-primary header-action" @onclick="IniciarCreacion">
            <i class="bi bi-person-plus" aria-hidden="true"></i>
            Nuevo contacto
        </button>
    </header>

    @if (mensajeExito is not null)
    {
        <div class="toast-message" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            @mensajeExito
        </div>
    }

    <section class="agenda-workspace" aria-label="Agenda de contactos">
        <aside class="master-panel" aria-label="Listado de contactos">
            <div class="search-box">
                <label for="busqueda">Buscar contactos</label>
                <div class="search-control">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="busqueda"
                           name="busqueda"
                           type="search"
                           autocomplete="off"
                           placeholder="Nombre, empresa, teléfono…"
                           @bind="textoBusqueda"
                           @bind:event="oninput"
                           @bind:after="ProgramarBusquedaAsync" />
                </div>
            </div>

            @if (cargando)
            {
                <div class="panel-state" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Cargando contactos…</span>
                </div>
            }
            else
            {
                <ListaContactos Contactos="contactos"
                                SeleccionadoId="contactoSeleccionado?.Id"
                                AlSeleccionar="SeleccionarContacto" />
            }
        </aside>

        <section class="detail-panel" aria-live="polite">
            @if (mensajeError is not null)
            {
                <div class="alert alert-danger m-4" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                    @mensajeError
                </div>
            }
            else if (modoPanel == ModoPanel.Formulario && contactoEnEdicion is not null)
            {
                <ContactoFormulario Modelo="contactoEnEdicion"
                                    EsNuevo="@(contactoEnEdicion.Id == 0)"
                                    Guardando="procesando"
                                    AlGuardar="GuardarContactoAsync"
                                    AlCancelar="CancelarEdicion" />
            }
            else if (modoPanel == ModoPanel.ConfirmarEliminacion && contactoSeleccionado is not null)
            {
                <ConfirmarEliminacion Contacto="contactoSeleccionado"
                                     Eliminando="procesando"
                                     AlConfirmar="EliminarContactoAsync"
                                     AlCancelar="CancelarEdicion" />
            }
            else if (contactoSeleccionado is not null)
            {
                <DetalleContacto Contacto="contactoSeleccionado"
                                 AlEditar="IniciarEdicion"
                                 AlEliminar="SolicitarEliminacion" />
            }
            else if (!cargando)
            {
                <div class="empty-detail">
                    <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
                    <h2>No hay un contacto para mostrar</h2>
                    <p>Probá con otra búsqueda para encontrar resultados.</p>
                </div>
            }
        </section>
    </section>
</main>

@code {
    private IReadOnlyList<Contacto> contactos = [];
    private Contacto? contactoSeleccionado;
    private Contacto? contactoEnEdicion;
    private string textoBusqueda = string.Empty;
    private string? mensajeError;
    private string? mensajeExito;
    private bool cargando = true;
    private bool procesando;
    private ModoPanel modoPanel = ModoPanel.Detalle;
    private CancellationTokenSource? busquedaPendiente;

    /// <summary>Carga la agenda y selecciona el primer contacto disponible.</summary>
    protected override async Task OnInitializedAsync()
    {
        await CargarContactosAsync();
    }

    /// <summary>
    /// Espera brevemente antes de consultar. El debounce evita enviar una
    /// consulta SQLite por cada tecla durante una escritura rápida.
    /// </summary>
    private async Task ProgramarBusquedaAsync()
    {
        busquedaPendiente?.Cancel();
        busquedaPendiente?.Dispose();
        busquedaPendiente = new CancellationTokenSource();

        try
        {
            await Task.Delay(250, busquedaPendiente.Token);
            await CargarContactosAsync(busquedaPendiente.Token);
        }
        catch (OperationCanceledException)
        {
            // Una búsqueda más reciente reemplazó a esta; no es un error.
        }
    }

    /// <summary>
    /// Refresca la colección y conserva la selección siempre que continúe
    /// visible dentro de los resultados filtrados.
    /// </summary>
    private async Task CargarContactosAsync(CancellationToken cancellationToken = default)
    {
        cargando = true;
        mensajeError = null;

        try
        {
            contactos = await Agenda.BuscarAsync(textoBusqueda, cancellationToken);
            var idSeleccionado = contactoSeleccionado?.Id;
            contactoSeleccionado = contactos.FirstOrDefault(item => item.Id == idSeleccionado)
                ?? contactos.FirstOrDefault();
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            mensajeError = "No fue posible leer la agenda. Intentá nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    /// <summary>Actualiza el panel de detalle con la fila elegida.</summary>
    private void SeleccionarContacto(Contacto contacto)
    {
        contactoSeleccionado = contacto;
        contactoEnEdicion = null;
        modoPanel = ModoPanel.Detalle;
        mensajeError = null;
        mensajeExito = null;
    }

    /// <summary>Prepara un modelo vacío sin modificar la lista actual.</summary>
    private void IniciarCreacion()
    {
        contactoEnEdicion = new Contacto();
        modoPanel = ModoPanel.Formulario;
        mensajeError = null;
        mensajeExito = null;
    }

    /// <summary>
    /// Crea una copia para que Cancelar descarte cambios y no altere el detalle
    /// antes de que Entity Framework confirme la actualización.
    /// </summary>
    private void IniciarEdicion()
    {
        if (contactoSeleccionado is null)
        {
            return;
        }

        contactoEnEdicion = Clonar(contactoSeleccionado);
        modoPanel = ModoPanel.Formulario;
        mensajeError = null;
        mensajeExito = null;
    }

    /// <summary>Muestra una segunda decisión antes de ejecutar el borrado.</summary>
    private void SolicitarEliminacion()
    {
        if (contactoSeleccionado is not null)
        {
            modoPanel = ModoPanel.ConfirmarEliminacion;
            mensajeError = null;
            mensajeExito = null;
        }
    }

    /// <summary>Vuelve al detalle sin persistir el modelo de edición.</summary>
    private void CancelarEdicion()
    {
        contactoEnEdicion = null;
        modoPanel = ModoPanel.Detalle;
        mensajeError = null;
    }

    /// <summary>Crea o actualiza según el identificador y refresca el maestro.</summary>
    private async Task GuardarContactoAsync(Contacto contacto)
    {
        procesando = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            if (contacto.Id == 0)
            {
                contactoSeleccionado = await Agenda.CrearAsync(contacto);
                mensajeExito = "El contacto se creó correctamente.";
            }
            else
            {
                var actualizado = await Agenda.ActualizarAsync(contacto);
                if (!actualizado)
                {
                    mensajeError = "El contacto ya no existe y no pudo actualizarse.";
                    return;
                }

                contactoSeleccionado = await Agenda.ObtenerAsync(contacto.Id);
                mensajeExito = "Los cambios se guardaron correctamente.";
            }

            contactoEnEdicion = null;
            modoPanel = ModoPanel.Detalle;
            await RecargarConSeleccionAsync(contactoSeleccionado?.Id);
        }
        catch (Exception)
        {
            mensajeError = "No fue posible guardar el contacto. Revisá los datos e intentá nuevamente.";
        }
        finally
        {
            procesando = false;
        }
    }

    /// <summary>Elimina el contacto seleccionado y elige el siguiente disponible.</summary>
    private async Task EliminarContactoAsync()
    {
        if (contactoSeleccionado is null)
        {
            return;
        }

        procesando = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            var nombre = $"{contactoSeleccionado.Nombre} {contactoSeleccionado.Apellido}";
            var eliminado = await Agenda.EliminarAsync(contactoSeleccionado.Id);
            if (!eliminado)
            {
                mensajeError = "El contacto ya no existe y no pudo eliminarse.";
                return;
            }

            contactoSeleccionado = null;
            modoPanel = ModoPanel.Detalle;
            await CargarContactosAsync();
            mensajeExito = $"{nombre} fue eliminado de la agenda.";
        }
        catch (Exception)
        {
            mensajeError = "No fue posible eliminar el contacto. Intentá nuevamente.";
        }
        finally
        {
            procesando = false;
        }
    }

    /// <summary>
    /// Recarga la lista tras una mutación y recupera la fila por identificador,
    /// incluso cuando el filtro actual dejó de coincidir con sus nuevos datos.
    /// </summary>
    private async Task RecargarConSeleccionAsync(int? id)
    {
        contactos = await Agenda.BuscarAsync(textoBusqueda);
        contactoSeleccionado = contactos.FirstOrDefault(item => item.Id == id);

        if (contactoSeleccionado is null && id.HasValue)
        {
            contactoSeleccionado = await Agenda.ObtenerAsync(id.Value);
        }

        contactoSeleccionado ??= contactos.FirstOrDefault();
    }

    /// <summary>Realiza una copia campo por campo apta para edición cancelable.</summary>
    private static Contacto Clonar(Contacto origen) => new()
    {
        Id = origen.Id,
        Nombre = origen.Nombre,
        Apellido = origen.Apellido,
        Telefono = origen.Telefono,
        Email = origen.Email,
        Empresa = origen.Empresa,
        Cargo = origen.Cargo,
        Direccion = origen.Direccion,
        FechaNacimiento = origen.FechaNacimiento,
        Notas = origen.Notas
    };

    /// <summary>Estados mutuamente excluyentes del panel derecho.</summary>
    private enum ModoPanel
    {
        Detalle,
        Formulario,
        ConfirmarEliminacion
    }

    /// <summary>Libera la búsqueda diferida cuando se abandona la página.</summary>
    public ValueTask DisposeAsync()
    {
        busquedaPendiente?.Cancel();
        busquedaPendiente?.Dispose();
        return ValueTask.CompletedTask;
    }
}
