@page "/"
@inject Repositorio Repositorio

<div class="d-flex flex-column vh-100">
    <!-- Cabecera -->
    <nav class="bg-dark d-flex justify-content-between align-items-center py-2 px-3">
        <div class="d-flex align-items-center">
            <i class="bi bi-journal-bookmark-fill me-2 text-white"></i>
            <h3 class="text-white mb-0">AgendaBlazor</h3>
        </div>
        <button class="btn btn-outline-primary text-white" type="button">
            <i class="bi bi-plus-circle"></i> Nuevo
        </button>
    </nav>

    <!-- Cuerpo Principal (Maestro-Detalle) -->
    <div class="d-flex flex-grow-1 w-100">
        <!-- Maestro (Sidebar) -->
        <div class="col-4 bg-secondary p-3">
            <input class="form-control mb-2" type="search" placeholder="Buscar contacto...">
        </div>

        <!-- Detalle -->
        <main class="col-8 bg-primary p-3">

        </main>
    </div>
</div>

@code {

    //Metodos
    List<Contacto> contactos = new List<Contacto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            contactos = await Repositorio.TraerContactos();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"{ex.Message}");
        }
    }
    async Task CrearContacto(Contacto c)
    {
        await Repositorio.AgregarContacto(c);
        contactos = await Repositorio.TraerContactos(); // Refresca la lista
    }

    async Task EditarContacto(Contacto c, int id)
    {
        await Repositorio.Actualizar(id, c);
        contactos = await Repositorio.TraerContactos();
    }

    async Task EliminarContacto(int id)
    {
        await Repositorio.Eliminar(id);
        contactos = await Repositorio.TraerContactos(); // Refresca la lista
    }

    public record class UIContacto(int id,
    string nombre,
    string apellido,
    string telefono,
    string email,
    string empresa,
    string cargo,
    string direccion,
    DateOnly? fechaNacimiento,
    string notas);
}