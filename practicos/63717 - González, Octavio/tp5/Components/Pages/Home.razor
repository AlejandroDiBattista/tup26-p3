@page "/"
@inject Repositorio Repo

<div class="d-flex flex-column vh-100">
    <!-- Cabecera -->
    <nav class="bg-dark d-flex justify-content-between align-items-center py-2 px-3">
        <div class="d-flex align-items-center">
            <i class="bi bi-journal-bookmark-fill me-2 text-white"></i>
            <h3 class="text-white mb-0">AgendaBlazor</h3>
        </div>
        <button class="btn btn-outline-primary text-white" type="button">
            <i class="bi bi-plus-circle"></i> Nuevo
        </button>
    </nav>

    <!-- Cuerpo Principal (Maestro-Detalle) -->
    <div class="d-flex flex-grow-1 w-100">
        <!-- Maestro (Sidebar) -->
        <div class="col-4 bg-secondary p-3">
            <input class="form-control mb-2" type="search" placeholder="Buscar contacto...">
        </div>

        <!-- Detalle -->
        <main class="col-8 bg-primary p-3">
            
        </main>
    </div>
</div>