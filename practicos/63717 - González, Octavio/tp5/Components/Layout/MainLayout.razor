            <i class="bi bi-journal-bookmark-fill me-2 text-white"></i>
            <h3 class="text-white"> AgendaBlazor </h3>
        </div>
        <button class="btn btn-outline-primary text-white h-100" type="button">
            <i class="bi bi-plus-circle"></i> Nuevo
        </button>
    </div>
</nav>
<div class="container-fluid">
