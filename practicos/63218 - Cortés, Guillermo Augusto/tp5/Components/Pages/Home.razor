@page "/"
@using tp5.Data
@using tp5.Models
@using Microsoft.EntityFrameworkCore
@inject AgendaContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Agenda de Contactos</h1>

    <div class="row g-4">

        <div class="col-12 col-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Contactos</h2>
                <button type="button" class="btn btn-primary btn-sm" @onclick="NuevoContacto">
                    Nuevo
                </button>
            </div>

            <div class="mb-3">
                <label class="form-label" for="buscarContacto">Buscar</label>
                <input
                    id="buscarContacto"
                    class="form-control"
                    placeholder="Nombre, telefono o email"
                    @bind="busqueda"
                    @bind:event="oninput" />
            </div>

            @if (!ContactosFiltrados.Any())
            {
                <div class="alert alert-warning mb-0">
                    No se encontraron contactos.
                </div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var contacto in ContactosFiltrados)
                    {
                        <button
                            type="button"
                            class="list-group-item list-group-item-action @(contactoSeleccionado?.Id == contacto.Id ? "active" : "")"
                            @onclick="() => SeleccionarContacto(contacto)">

                            <strong>@contacto.Apellido, @contacto.Nombre</strong><br />
                            <small>@contacto.Telefono</small><br />
                            <small>@contacto.Email</small>

                        </button>
                    }
                </div>
            }
        </div>

        <div class="col-12 col-md-8">
            <h2 class="h5 mb-3">Detalle</h2>
            @if (mostrandoFormulario)
            {
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title h5">@(editandoContacto ? "Editar contacto" : "Nuevo contacto")</h3>

                        <EditForm Model="contactoFormulario" OnValidSubmit="GuardarContacto">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="nombre">Nombre</label>
                                    <InputText id="nombre" class="form-control" @bind-Value="contactoFormulario.Nombre" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="apellido">Apellido</label>
                                    <InputText id="apellido" class="form-control" @bind-Value="contactoFormulario.Apellido" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="telefono">Telefono</label>
                                    <InputText id="telefono" class="form-control" @bind-Value="contactoFormulario.Telefono" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="email">Email</label>
                                    <InputText id="email" class="form-control" @bind-Value="contactoFormulario.Email" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="empresa">Empresa</label>
                                    <InputText id="empresa" class="form-control" @bind-Value="contactoFormulario.Empresa" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="cargo">Cargo</label>
                                    <InputText id="cargo" class="form-control" @bind-Value="contactoFormulario.Cargo" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="direccion">Direccion</label>
                                    <InputText id="direccion" class="form-control" @bind-Value="contactoFormulario.Direccion" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="fechaNacimiento">Fecha de nacimiento</label>
                                    <InputDate id="fechaNacimiento" class="form-control" @bind-Value="contactoFormulario.FechaNacimiento" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="notas">Notas</label>
                                    <InputTextArea id="notas" class="form-control" @bind-Value="contactoFormulario.Notas" />
                                </div>
                            </div>

                            <div class="mt-3">
                                <button type="submit" class="btn btn-primary">Guardar</button>
                                <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarFormulario">Cancelar</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else if (contactoSeleccionado is null)
            {
                <div class="alert alert-info">
                    Seleccione un contacto.
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h3 class="card-title mb-0">
                                @contactoSeleccionado.Nombre
                                @contactoSeleccionado.Apellido
                            </h3>

                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="EditarContacto">
                                Editar
                            </button>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4">Telefono</dt>
                            <dd class="col-sm-8">@contactoSeleccionado.Telefono</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@contactoSeleccionado.Email</dd>

                            <dt class="col-sm-4">Empresa</dt>
                            <dd class="col-sm-8">@MostrarDato(contactoSeleccionado.Empresa)</dd>

                            <dt class="col-sm-4">Cargo</dt>
                            <dd class="col-sm-8">@MostrarDato(contactoSeleccionado.Cargo)</dd>

                            <dt class="col-sm-4">Direccion</dt>
                            <dd class="col-sm-8">@MostrarDato(contactoSeleccionado.Direccion)</dd>

                            <dt class="col-sm-4">Fecha de nacimiento</dt>
                            <dd class="col-sm-8">@MostrarFecha(contactoSeleccionado.FechaNacimiento)</dd>

                            <dt class="col-sm-4">Notas</dt>
                            <dd class="col-sm-8">@MostrarDato(contactoSeleccionado.Notas)</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@code {
    private List<Contacto> contactos = [];
    private Contacto? contactoSeleccionado;
    private Contacto contactoFormulario = new();
    private string busqueda = "";
    private bool mostrandoFormulario;
    private bool editandoContacto;

    private IEnumerable<Contacto> ContactosFiltrados => contactos.Where(CoincideBusqueda);

    protected override async Task OnInitializedAsync()
    {
        await CargarContactos();
    }

    private async Task CargarContactos()
    {
        contactos = await Db.Contactos
            .OrderBy(contacto => contacto.Apellido)
            .ThenBy(contacto => contacto.Nombre)
            .ToListAsync();
    }

    private void SeleccionarContacto(Contacto contacto)
    {
        contactoSeleccionado = contacto;
        mostrandoFormulario = false;
        editandoContacto = false;
    }

    private void NuevoContacto()
    {
        contactoFormulario = new Contacto();
        contactoSeleccionado = null;
        mostrandoFormulario = true;
        editandoContacto = false;
    }

    private void EditarContacto()
    {
        if (contactoSeleccionado is null)
        {
            return;
        }

        contactoFormulario = CopiarContacto(contactoSeleccionado);
        mostrandoFormulario = true;
        editandoContacto = true;
    }

    private void CancelarFormulario()
    {
        contactoFormulario = new Contacto();
        mostrandoFormulario = false;
        editandoContacto = false;
    }

    private async Task GuardarContacto()
    {
        if (editandoContacto)
        {
            var contactoGuardado = await Db.Contactos.FindAsync(contactoFormulario.Id);

            if (contactoGuardado is not null)
            {
                CopiarDatos(contactoFormulario, contactoGuardado);
                await Db.SaveChangesAsync();
            }
        }
        else
        {
            Db.Contactos.Add(contactoFormulario);
            await Db.SaveChangesAsync();
        }

        var idSeleccionado = contactoFormulario.Id;
        await CargarContactos();

        contactoSeleccionado = contactos.FirstOrDefault(contacto => contacto.Id == idSeleccionado);
        contactoFormulario = new Contacto();
        busqueda = "";
        mostrandoFormulario = false;
        editandoContacto = false;
    }

    private bool CoincideBusqueda(Contacto contacto)
    {
        if (string.IsNullOrWhiteSpace(busqueda))
        {
            return true;
        }

        var texto = busqueda.Trim();

        return contacto.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)
            || contacto.Apellido.Contains(texto, StringComparison.OrdinalIgnoreCase)
            || contacto.Telefono.Contains(texto, StringComparison.OrdinalIgnoreCase)
            || contacto.Email.Contains(texto, StringComparison.OrdinalIgnoreCase);
    }

    private static Contacto CopiarContacto(Contacto contacto)
    {
        return new Contacto
        {
            Id = contacto.Id,
            Nombre = contacto.Nombre,
            Apellido = contacto.Apellido,
            Telefono = contacto.Telefono,
            Email = contacto.Email,
            Empresa = contacto.Empresa,
            Cargo = contacto.Cargo,
            Direccion = contacto.Direccion,
            FechaNacimiento = contacto.FechaNacimiento,
            Notas = contacto.Notas
        };
    }

    private static void CopiarDatos(Contacto origen, Contacto destino)
    {
        destino.Nombre = origen.Nombre;
        destino.Apellido = origen.Apellido;
        destino.Telefono = origen.Telefono;
        destino.Email = origen.Email;
        destino.Empresa = origen.Empresa;
        destino.Cargo = origen.Cargo;
        destino.Direccion = origen.Direccion;
        destino.FechaNacimiento = origen.FechaNacimiento;
        destino.Notas = origen.Notas;
    }

    private static string MostrarDato(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    }

    private static string MostrarFecha(DateOnly? fecha)
    {
        return fecha?.ToString("dd/MM/yyyy") ?? "-";
    }
}