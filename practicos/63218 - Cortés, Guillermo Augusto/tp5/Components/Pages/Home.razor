@page "/"
@using tp5.Data
@using tp5.Models
@inject AgendaContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Agenda de Contactos</h1>

    <div class="list-group">
        @foreach (var contacto in contactos)
        {
            <div class="list-group-item">
                <strong>@contacto.Apellido, @contacto.Nombre</strong><br />
                <small>@contacto.Telefono</small>
            </div>
        }
    </div>
</div>

@code {
    private List<Contacto> contactos = [];

    protected override void OnInitialized(){
        contactos = Db.Contactos.ToList();
    }
}
