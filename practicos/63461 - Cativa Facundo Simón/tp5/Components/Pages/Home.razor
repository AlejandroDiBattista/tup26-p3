@page "/"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using tp5.Data
@using tp5.Models
@inject AgendaDbContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
    <h1 class="mb-0">Agenda</h1>
    <p class="text-muted">
        Contactos personales y profesionales
    </p>
</div>

    <button class="btn btn-primary"
            @onclick="PrepararNuevoContacto">
       ➕ Nuevo contacto
    </button>
</div>

<div class="mb-3">
    <input class="form-control"
           placeholder="🔍 Buscar contacto..."
           @bind="busqueda"
           @bind:event="oninput" />
</div>

@if (contactos == null)
{
    <p>Cargando contactos...</p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <ul class="list-group">
                @foreach (var contacto in ContactosFiltrados)
                {
                    <li class="list-group-item @(contacto == contactoSeleccionado ? "active" : "")"
                        @onclick="() => SeleccionarContacto(contacto)"
                        style="cursor: pointer;">
                       <div class="d-flex align-items-center">
    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2"
         style="width:40px; height:40px;">
        @ObtenerIniciales(contacto)
    </div>

    <div>
        @contacto.Nombre @contacto.Apellido
    </div>
</div>

                    </li>
                }
            </ul>
        </div>

        <div class="col-md-8">

            @if (mostrandoFormulario)
{
    <div class="card mb-3">
        <div class="card-header">
            <h4>Nuevo contacto</h4>
        </div>

        <div class="card-body">
            <EditForm Model="nuevoContacto"
                      OnValidSubmit="GuardarNuevoContacto">

                <div class="mb-2">
                    <label>Nombre</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoContacto.Nombre" />
                </div>

                <div class="mb-2">
                    <label>Apellido</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoContacto.Apellido" />
                </div>

                <div class="mb-2">
                    <label>Teléfono</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoContacto.Telefono" />
                </div>

                <div class="mb-2">
                    <label>Email</label>
                    <InputText class="form-control"
                               @bind-Value="nuevoContacto.Email" />
                </div>

                <button type="submit"
                        class="btn btn-success me-2">
                    Guardar
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="() => mostrandoFormulario = false">
                    Cancelar
                </button>
            </EditForm>
        </div>
    </div>
}

            @if (contactoSeleccionado is null)
            {
                <div class="alert alert-info">
                    Seleccione un contacto para ver sus detalles.
                </div>
            }
            else
            {
               @if (editando)
{
    <div class="card mb-3">
        <div class="card-header">
            <h4>Editar contacto</h4>
        </div>

        <div class="card-body">

            <div class="mb-2">
                <label>Nombre</label>
                <InputText class="form-control"
                           @bind-Value="contactoSeleccionado.Nombre" />
            </div>

            <div class="mb-2">
                <label>Apellido</label>
                <InputText class="form-control"
                           @bind-Value="contactoSeleccionado.Apellido" />
            </div>

            <div class="mb-2">
                <label>Teléfono</label>
                <InputText class="form-control"
                           @bind-Value="contactoSeleccionado.Telefono" />
            </div>

            <div class="mb-2">
                <label>Email</label>
                <InputText class="form-control"
                           @bind-Value="contactoSeleccionado.Email" />
            </div>

            <div class="mb-2">
                <label>Empresa</label>
                <InputText class="form-control"
                           @bind-Value="contactoSeleccionado.Empresa" />
            </div>

            <div class="mb-2">
                <label>Cargo</label>
                <InputText class="form-control"
                           @bind-Value="contactoSeleccionado.Cargo" />
            </div>

            <div class="mb-2">
                <label>Dirección</label>
                <InputText class="form-control"
                           @bind-Value="contactoSeleccionado.Direccion" />
            </div>

            <div class="mb-2">
                <label>Notas</label>
                <InputText class="form-control"
                           @bind-Value="contactoSeleccionado.Notas" />
            </div>

            <button class="btn btn-success me-2"
                    @onclick="GuardarCambios">
                Guardar cambios
            </button>

            <button class="btn btn-secondary"
                    @onclick="CancelarEdicion">
                Cancelar
            </button>

        </div>
    </div>
}

                <div class="card">
                    <div class="card-header">
                        <h4>@contactoSeleccionado.Nombre @contactoSeleccionado.Apellido</h4>
                    </div>

                    <div class="card-body">
                        <p><strong>Teléfono:</strong> @contactoSeleccionado.Telefono</p>
                        <p><strong>Email:</strong> @contactoSeleccionado.Email</p>
                        <p><strong>Empresa:</strong> @contactoSeleccionado.Empresa</p>
                        <p><strong>Cargo:</strong> @contactoSeleccionado.Cargo</p>
                        <p><strong>Dirección:</strong> @contactoSeleccionado.Direccion</p>
                        <p><strong>Fecha de nacimiento:</strong> @(contactoSeleccionado.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")</p>
                        <p><strong>Notas:</strong> @contactoSeleccionado.Notas</p>
                        <button class="btn btn-warning mt-3 me-2"
        @onclick="ComenzarEdicion">
   ✏️ Editar
</button>

<button class="btn btn-danger mt-3"
        @onclick="EliminarContacto">
  🗑️ Eliminar
</button>
                        
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {

    private string busqueda = "";
    private List<Contacto>? contactos;

        private Contacto? contactoSeleccionado;

        private bool mostrandoFormulario = false;
private Contacto nuevoContacto = new();

private bool editando = false;

        private IEnumerable<Contacto> ContactosFiltrados =>
    string.IsNullOrWhiteSpace(busqueda)
        ? contactos ?? Enumerable.Empty<Contacto>()
        : (contactos ?? Enumerable.Empty<Contacto>())
            .Where(c =>
                c.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                c.Apellido.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                c.Email.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        contactos = await Db.Contactos
            .OrderBy(c => c.Apellido)
            .ThenBy(c => c.Nombre)
            .ToListAsync();
    }
    private void SeleccionarContacto(Contacto contacto)
{
    contactoSeleccionado = contacto;
}

private async Task EliminarContacto()
{
    if (contactoSeleccionado is null)
        return;

    Db.Contactos.Remove(contactoSeleccionado);

    await Db.SaveChangesAsync();

    contactos?.Remove(contactoSeleccionado);

    contactoSeleccionado = null;
}

private void PrepararNuevoContacto()
{
    nuevoContacto = new Contacto();
    mostrandoFormulario = true;
}

private async Task GuardarNuevoContacto()
{
    Db.Contactos.Add(nuevoContacto);

    await Db.SaveChangesAsync();

    contactos ??= new List<Contacto>();

    contactos.Add(nuevoContacto);

    contactos = contactos
        .OrderBy(c => c.Apellido)
        .ThenBy(c => c.Nombre)
        .ToList();

    mostrandoFormulario = false;

    contactoSeleccionado = nuevoContacto;
}

private void ComenzarEdicion()
{
    editando = true;
}

private async Task GuardarCambios()
{
    await Db.SaveChangesAsync();

    contactos = contactos?
        .OrderBy(c => c.Apellido)
        .ThenBy(c => c.Nombre)
        .ToList();

    editando = false;
}

private void CancelarEdicion()
{
    editando = false;
}
private string ObtenerIniciales(Contacto contacto)
{
    var iniciales = "";

    if (!string.IsNullOrWhiteSpace(contacto.Nombre))
        iniciales += contacto.Nombre[0];

    if (!string.IsNullOrWhiteSpace(contacto.Apellido))
        iniciales += contacto.Apellido[0];

    return iniciales.ToUpper();
}

}
