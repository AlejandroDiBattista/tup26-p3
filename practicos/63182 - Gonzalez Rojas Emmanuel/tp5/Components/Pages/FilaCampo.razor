<div class="fila-campo">
    <i class="bi @Icono icono-campo" aria-hidden="true"></i>

    <div class="contenido-fila">
        <span class="etiqueta-fila">@Etiqueta</span>

        @if (!string.IsNullOrWhiteSpace(Href))
        {
            <a class="valor-enlace" href="@Href">@Valor</a>
        }
        else
        {
            <span class="valor-fila">@Valor</span>
        }
    </div>
</div>

@code {
    [Parameter] public string Icono { get; set; } = "bi-circle";
    [Parameter] public string Etiqueta { get; set; } = "";
    [Parameter] public string? Valor { get; set; }

    [Parameter] public bool EsEnlace { get; set; } = false;
    [Parameter] public string TipoEnlace { get; set; } = "";

    private string Href
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Valor))
                return "";

            return TipoEnlace.ToLowerInvariant() switch
            {
                "email" => $"mailto:{Valor}",
                "telefono" => $"tel:{Valor}",
                _ => EsEnlace ? $"mailto:{Valor}" : ""
            };
        }
    }
}
