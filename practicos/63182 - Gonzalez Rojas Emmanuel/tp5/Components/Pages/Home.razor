@page "/"
@rendermode InteractiveServer

@inject AgendaServicio Agenda

@using tp5.Services

<PageTitle>TP5: AgendaWeb</PageTitle>

<main class="agenda-shell" aria-labelledby="agenda-title">
    <aside class="chat-sidebar" aria-label="Contactos">
        <header class="sidebar-header">
            <div>
                <p class="eyebrow">AgendaWeb</p>
                <h1 id="agenda-title">Contactos</h1>
            </div>
            <button type="button" class="icon-button primary-action" title="Nuevo contacto" @onclick="AbrirNuevo">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span class="visually-hidden">Nuevo contacto</span>
            </button>
        </header>

        <search class="search-panel">
            <label for="buscar-contacto">Buscar contacto</label>
            <div class="search-box">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="buscar-contacto"
                       name="buscar"
                       type="search"
                       autocomplete="off"
                       placeholder="Buscar por nombre, empresa o email"
                       value="@textoBusqueda"
                       @oninput="ActualizarBusqueda" />
            </div>
        </search>

        <nav class="filter-tabs" aria-label="Filtros de contactos">
            <button type="button" class="@ClaseFiltro("todos")" @onclick='() => CambiarFiltro("todos")'>
                Todos <span>@todosLosContactos.Count</span>
            </button>
            <button type="button" class="@ClaseFiltro("empresa")" @onclick='() => CambiarFiltro("empresa")'>
                Empresa <span>@CantidadConEmpresa</span>
            </button>
            <button type="button" class="@ClaseFiltro("cumpleanos")" @onclick='() => CambiarFiltro("cumpleanos")'>
                Cumpleaños <span>@CantidadConCumpleanos</span>
            </button>
        </nav>

        <section class="contact-list" aria-live="polite">
            @if (contactosFiltrados.Count == 0)
            {
                <div class="empty-list">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <p>No hay contactos para mostrar.</p>
                </div>
            }
            else
            {
                @foreach (var contacto in contactosFiltrados)
                {
                    var seleccionado = contactoSeleccionado?.Id == contacto.Id && !mostrandoFormulario;
                    <button type="button"
                            class="contact-row @(seleccionado ? "selected" : "")"
                            @onclick="() => Seleccionar(contacto)">
                        <span class="avatar @AvatarClase(contacto.Id)" aria-hidden="true">@contacto.Iniciales</span>
                        <span class="contact-copy">
                            <span class="contact-title">@contacto.NombreCompleto</span>
                            <span class="contact-preview">@TextoResumen(contacto)</span>
                        </span>
                        <span class="contact-meta">@InicialApellido(contacto)</span>
                    </button>
                }
            }
        </section>
    </aside>

    <section class="detail-pane" aria-label="Detalle del contacto">
        <header class="detail-topbar">
            <div class="detail-identity">
                <span class="avatar large @(contactoSeleccionado is null ? "avatar-neutral" : AvatarClase(contactoSeleccionado.Id))" aria-hidden="true">
                    @AvatarActual
                </span>
                <div>
                    <p class="eyebrow">TP5 AgendaWeb</p>
                    <h2>@TituloDetalle</h2>
                    <p>@SubtituloDetalle</p>
                </div>
            </div>

            <div class="detail-actions">
                <button type="button" class="pill-button" @onclick="AbrirNuevo">
                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                    Nuevo
                </button>

                @if (contactoSeleccionado is not null && !mostrandoFormulario)
                {
                    <button type="button" class="icon-button" title="Editar contacto" @onclick="AbrirEdicion">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                        <span class="visually-hidden">Editar contacto</span>
                    </button>
                    <button type="button" class="icon-button danger" title="Eliminar contacto" @onclick="PrepararEliminacion">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                        <span class="visually-hidden">Eliminar contacto</span>
                    </button>
                }
            </div>
        </header>

        <div class="conversation-surface">
            @if (mostrandoFormulario)
            {
                <article class="message-card form-message">
                    <header class="message-header">
                        <span>@(esNuevo ? "Nuevo contacto" : "Editar contacto")</span>
                        <time>@DateTime.Now.ToString("HH:mm")</time>
                    </header>

                    @if (!string.IsNullOrWhiteSpace(mensajeError))
                    {
                        <div class="form-alert" role="alert">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            @mensajeError
                        </div>
                    }

                    <form class="contact-form" @onsubmit="PedirConfirmacionGuardar" @onsubmit:preventDefault>
                        <fieldset>
                            <legend>Datos principales</legend>
                            <div class="form-grid">
                                <label>
                                    <span>Nombre *</span>
                                    <input name="nombre" autocomplete="given-name" required @bind="contactoEnEdicion.Nombre" />
                                </label>
                                <label>
                                    <span>Apellido *</span>
                                    <input name="apellido" autocomplete="family-name" required @bind="contactoEnEdicion.Apellido" />
                                </label>
                                <label>
                                    <span>Teléfono *</span>
                                    <input name="telefono" autocomplete="tel" required @bind="contactoEnEdicion.Telefono" />
                                </label>
                                <label>
                                    <span>Email *</span>
                                    <input name="email" type="email" autocomplete="email" required @bind="contactoEnEdicion.Email" />
                                </label>
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend>Información adicional</legend>
                            <div class="form-grid">
                                <label>
                                    <span>Empresa</span>
                                    <input name="empresa" autocomplete="organization" @bind="contactoEnEdicion.Empresa" />
                                </label>
                                <label>
                                    <span>Cargo</span>
                                    <input name="cargo" autocomplete="organization-title" @bind="contactoEnEdicion.Cargo" />
                                </label>
                                <label>
                                    <span>Dirección</span>
                                    <input name="direccion" autocomplete="street-address" @bind="contactoEnEdicion.Direccion" />
                                </label>
                                <label>
                                    <span>Fecha de nacimiento</span>
                                    <input name="fecha-nacimiento"
                                           type="date"
                                           value="@(contactoEnEdicion.FechaNacimiento?.ToString("yyyy-MM-dd") ?? "")"
                                           @onchange="e => CambiarFecha(e.Value?.ToString())" />
                                </label>
                                <label class="full-field">
                                    <span>Notas</span>
                                    <textarea name="notas" rows="4" @bind="contactoEnEdicion.Notas"></textarea>
                                </label>
                            </div>
                        </fieldset>

                        <div class="form-actions">
                            <button type="button" class="ghost-button" @onclick="CancelarFormulario">Cancelar</button>
                            <button type="submit" class="save-button">
                                <i class="bi bi-check2" aria-hidden="true"></i>
                                @(esNuevo ? "Crear contacto" : "Guardar cambios")
                            </button>
                        </div>
                    </form>
                </article>
            }
            else if (contactoSeleccionado is not null)
            {
                <article class="message-card contact-detail">
                    <header class="message-header">
                        <span>@contactoSeleccionado.NombreCompleto</span>
                        <time>@DateTime.Now.ToString("HH:mm")</time>
                    </header>

                    <div class="profile-card">
                        <span class="avatar xlarge @AvatarClase(contactoSeleccionado.Id)" aria-hidden="true">@contactoSeleccionado.Iniciales</span>
                        <div>
                            <h3>@contactoSeleccionado.NombreCompleto</h3>
                            <p>@(string.IsNullOrWhiteSpace(contactoSeleccionado.Empresa) ? "Contacto independiente" : contactoSeleccionado.Empresa)</p>
                            @if (!string.IsNullOrWhiteSpace(contactoSeleccionado.Cargo))
                            {
                                <span class="role-chip">@contactoSeleccionado.Cargo</span>
                            }
                        </div>
                    </div>

                    <div class="detail-grid">
                        <FilaCampo Icono="bi-envelope" Etiqueta="Email" Valor="@contactoSeleccionado.Email" TipoEnlace="email" />
                        <FilaCampo Icono="bi-telephone" Etiqueta="Teléfono" Valor="@contactoSeleccionado.Telefono" TipoEnlace="telefono" />
                        @if (!string.IsNullOrWhiteSpace(contactoSeleccionado.Empresa))
                        {
                            <FilaCampo Icono="bi-building" Etiqueta="Empresa" Valor="@contactoSeleccionado.Empresa" />
                        }
                        @if (!string.IsNullOrWhiteSpace(contactoSeleccionado.Cargo))
                        {
                            <FilaCampo Icono="bi-briefcase" Etiqueta="Cargo" Valor="@contactoSeleccionado.Cargo" />
                        }
                        @if (!string.IsNullOrWhiteSpace(contactoSeleccionado.Direccion))
                        {
                            <FilaCampo Icono="bi-geo-alt" Etiqueta="Dirección" Valor="@contactoSeleccionado.Direccion" />
                        }
                        @if (contactoSeleccionado.FechaNacimiento.HasValue)
                        {
                            <FilaCampo Icono="bi-cake" Etiqueta="Nacimiento" Valor="@contactoSeleccionado.FechaNacimiento.Value.ToString("dd/MM/yyyy")" />
                        }
                        @if (!string.IsNullOrWhiteSpace(contactoSeleccionado.Notas))
                        {
                            <FilaCampo Icono="bi-journal-text" Etiqueta="Notas" Valor="@contactoSeleccionado.Notas" />
                        }
                    </div>
                </article>
            }
            else
            {
                <article class="empty-detail">
                    <span class="avatar xlarge avatar-neutral" aria-hidden="true"><i class="bi bi-person-lines-fill"></i></span>
                    <h3>Seleccioná un contacto</h3>
                    <p>La información completa y las acciones de edición aparecen en este panel.</p>
                </article>
            }
        </div>
    </section>
</main>

@if (mostrarConfirmacionGuardar)
{
    <div class="modal-backdrop" @onclick="CancelarConfirmacion"></div>
    <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="guardar-titulo">
        <h2 id="guardar-titulo">@(esNuevo ? "Crear contacto" : "Guardar cambios")</h2>
        <p>Confirmá la operación para <strong>@contactoEnEdicion.NombreCompleto</strong>.</p>
        <div class="dialog-actions">
            <button type="button" class="ghost-button" @onclick="CancelarConfirmacion">Cancelar</button>
            <button type="button" class="save-button" @onclick="GuardarConfirmado">
                @(esNuevo ? "Crear" : "Guardar")
            </button>
        </div>
    </section>
}

@if (contactoAEliminar is not null)
{
    <div class="modal-backdrop" @onclick="CancelarEliminacion"></div>
    <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="eliminar-titulo">
        <h2 id="eliminar-titulo">Eliminar contacto</h2>
        <p>Esta acción quitará a <strong>@contactoAEliminar.NombreCompleto</strong> de la agenda.</p>
        <div class="dialog-actions">
            <button type="button" class="ghost-button" @onclick="CancelarEliminacion">Cancelar</button>
            <button type="button" class="delete-button" @onclick="EliminarConfirmado">Eliminar</button>
        </div>
    </section>
}

@code {
    private List<Contacto> todosLosContactos = [];
    private List<Contacto> contactosFiltrados = [];
    private Contacto? contactoSeleccionado;
    private Contacto contactoEnEdicion = new();
    private Contacto? contactoAEliminar;
    private string textoBusqueda = "";
    private string filtroActivo = "todos";
    private string mensajeError = "";
    private bool mostrandoFormulario;
    private bool mostrarConfirmacionGuardar;
    private bool esNuevo;

    private int CantidadConEmpresa => todosLosContactos.Count(c => !string.IsNullOrWhiteSpace(c.Empresa));
    private int CantidadConCumpleanos => todosLosContactos.Count(c => c.FechaNacimiento.HasValue);
    private string AvatarActual => mostrandoFormulario
        ? (string.IsNullOrWhiteSpace(contactoEnEdicion.Iniciales) ? "?" : contactoEnEdicion.Iniciales)
        : contactoSeleccionado?.Iniciales ?? "?";
    private string TituloDetalle => mostrandoFormulario
        ? (esNuevo ? "Nuevo contacto" : "Editar contacto")
        : contactoSeleccionado?.NombreCompleto ?? "Agenda de contactos";
    private string SubtituloDetalle => mostrandoFormulario
        ? "Completá los datos y confirmá para persistir en SQLite"
        : contactoSeleccionado is null
            ? "Elegí una conversación de la lista para ver el detalle"
            : TextoResumen(contactoSeleccionado);

    protected override async Task OnInitializedAsync()
    {
        await CargarContactosAsync();
    }

    private async Task CargarContactosAsync(int? seleccionarId = null)
    {
        todosLosContactos = await Agenda.ObtenerContactosAsync();
        AplicarFiltros();

        if (seleccionarId.HasValue)
            contactoSeleccionado = todosLosContactos.FirstOrDefault(c => c.Id == seleccionarId.Value);
        else if (contactoSeleccionado is not null)
            contactoSeleccionado = todosLosContactos.FirstOrDefault(c => c.Id == contactoSeleccionado.Id);
    }

    private void ActualizarBusqueda(ChangeEventArgs evento)
    {
        textoBusqueda = evento.Value?.ToString() ?? "";
        AplicarFiltros();
    }

    private void CambiarFiltro(string filtro)
    {
        filtroActivo = filtro;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        contactosFiltrados = AgendaServicio.Filtrar(todosLosContactos, textoBusqueda, filtroActivo);
    }

    private void Seleccionar(Contacto contacto)
    {
        contactoSeleccionado = contacto;
        mostrandoFormulario = false;
        mostrarConfirmacionGuardar = false;
        mensajeError = "";
    }

    private void AbrirNuevo()
    {
        esNuevo = true;
        mostrandoFormulario = true;
        contactoEnEdicion = new Contacto();
        mensajeError = "";
    }

    private void AbrirEdicion()
    {
        if (contactoSeleccionado is null)
            return;

        esNuevo = false;
        mostrandoFormulario = true;
        contactoEnEdicion = AgendaServicio.Copiar(contactoSeleccionado);
        mensajeError = "";
    }

    private void CancelarFormulario()
    {
        mostrandoFormulario = false;
        mostrarConfirmacionGuardar = false;
        mensajeError = "";
    }

    private void PedirConfirmacionGuardar()
    {
        mensajeError = Validar(contactoEnEdicion);
        mostrarConfirmacionGuardar = string.IsNullOrWhiteSpace(mensajeError);
    }

    private void CancelarConfirmacion()
    {
        mostrarConfirmacionGuardar = false;
    }

    private async Task GuardarConfirmado()
    {
        try
        {
            var guardado = await Agenda.GuardarAsync(contactoEnEdicion);
            await CargarContactosAsync(guardado.Id);
            mostrandoFormulario = false;
            mostrarConfirmacionGuardar = false;
            mensajeError = "";
        }
        catch (Exception ex)
        {
            mostrarConfirmacionGuardar = false;
            mensajeError = $"No se pudo guardar el contacto: {ex.Message}";
        }
    }

    private void PrepararEliminacion()
    {
        contactoAEliminar = contactoSeleccionado;
    }

    private void CancelarEliminacion()
    {
        contactoAEliminar = null;
    }

    private async Task EliminarConfirmado()
    {
        if (contactoAEliminar is null)
            return;

        await Agenda.EliminarAsync(contactoAEliminar.Id);
        contactoAEliminar = null;
        contactoSeleccionado = null;
        await CargarContactosAsync();
    }

    private void CambiarFecha(string? valor)
    {
        contactoEnEdicion.FechaNacimiento = DateOnly.TryParse(valor, out var fecha) ? fecha : null;
    }

    private static string Validar(Contacto contacto)
    {
        if (string.IsNullOrWhiteSpace(contacto.Nombre) ||
            string.IsNullOrWhiteSpace(contacto.Apellido) ||
            string.IsNullOrWhiteSpace(contacto.Telefono) ||
            string.IsNullOrWhiteSpace(contacto.Email))
        {
            return "Nombre, apellido, teléfono y email son obligatorios.";
        }

        if (!contacto.Email.Contains('@', StringComparison.Ordinal))
            return "Ingresá un email válido.";

        return "";
    }

    private string ClaseFiltro(string filtro)
    {
        return filtroActivo == filtro ? "filter-chip active" : "filter-chip";
    }

    private static string TextoResumen(Contacto contacto)
    {
        if (!string.IsNullOrWhiteSpace(contacto.Cargo) && !string.IsNullOrWhiteSpace(contacto.Empresa))
            return $"{contacto.Cargo} en {contacto.Empresa}";

        if (!string.IsNullOrWhiteSpace(contacto.Empresa))
            return contacto.Empresa;

        return string.IsNullOrWhiteSpace(contacto.Notas) ? contacto.Email : contacto.Notas;
    }

    private static string InicialApellido(Contacto contacto)
    {
        return string.IsNullOrWhiteSpace(contacto.Apellido)
            ? ""
            : contacto.Apellido[..1].ToUpperInvariant();
    }

    private static string AvatarClase(int id)
    {
        var clases = new[] { "avatar-mint", "avatar-lilac", "avatar-sand", "avatar-sky", "avatar-rose", "avatar-teal" };
        return clases[Math.Abs(id) % clases.Length];
    }
}
