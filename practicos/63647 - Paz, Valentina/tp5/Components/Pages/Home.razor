@page "/"
@rendermode InteractiveServer 
@using Microsoft.EntityFrameworkCore
@using tp5.Data
@using tp5.Models
@inject AgendaContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

    <h1 class="display-3 fw-bold"><i class="bi bi-person-vcard me-3"></i>TP5: AgendaWeb</h1>

@if (contactos is null)
{
     <p> cargando contactos.. </p>
}
else 
{
     <p>Total de  contactos : @contactos.Count </p>
    
    <div class="row">
      <div class="col-md-5">
        <div class="d-flex justicy-content-between align-items-center mb-3">
         <h2 class="h4 mb-0">Contactos</h2> 

         <button class="btn btn-primary" @onclick="NuevoContacto">
          Nuevo
          </button>
        </div>

         <input type="search"
                class"form-control mb-3
                placeholder="Buscar por nombre o apellido.."
                @bind="textoBusqueda"
                @bind:event="oninput" />
         
          <div class="list-group">
               @foreach (var contacto in ContactosFiltrados) 
               {
                   <button type ="button"
                           class="list-group-item list-group-item-action"
                           @onclick="() => SeleccionarContacto(contacto)">
                         <strong>@contacto.Nombre @contacto.Apellido</strong>
                         <br/>
                         <small>@contacto.Telefono @contacto.Email</small>
                    </button>
                } 
            </div>
        </div>

        <div class="col-md-7">
            <h2 class="h4">Detalle</h2>
            
            @if (modoNuevo)
           {
               <div class="border rounded p-3">
                    <h3 class="h5">Nuevo contacto</h3>

                    <div class="mb-3">
                          <label class="form-label">Nombre</label>
                          <input class="form-control"
                                 @bind="nuevoContacto.Nombre" />
                    </div>

                    <div class="mb-3">
                         <label class="form-label">Apellido</label>
                         <input class="form-control"
                                @bind="nuevoContacto.Apellido" />
                    </div>

                    <div class="mb-3">
                         <label class="form-label">Teléfono</label>
                         <input class="form-control"
                                @bind="nuevoContacto.Telefono" />
                    </div>

                    <div class="mb-3">
                         <label class="form-label">Email</label>
                        <input type="email"
                               class="form-control"
                                @bind="nuevoContacto.Email" />
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                       {
                          <div class="alert alert-danger">
                               @mensajeError
                         </div>
                        }

                        <button type="button"
                                class="btn btn-success"
                                @onclick="GuardarContacto">
                          Guardar
                        </button>

                        <button type="button"
                                class="btn btn-secondary ms-2"
                                @onclick="CancelarNuevo">
                          Cancelar
                        </button>
              </div>
            }
            else if (modoEditar)
           {
              <div class="border rounded p-3">
                    <h3 class="h5">Editar contacto</h3>

                    <div class="mb-3">
                         <label class="form-label">Nombre</label>
                         <input class="form-control"
                                @bind="contactoEditado.Nombre" />
                   </div>

                   <div class="mb-3">
                        <label class="form-label">Apellido</label>
                        <input class="form-control"
                               @bind="contactoEditado.Apellido" />
                    </div>

                    <div class="mb-3">
                         <label class="form-label">Teléfono</label>
                         <input class="form-control"
                                @bind="contactoEditado.Telefono" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email"
                               class="form-control"
                               @bind="contactoEditado.Email" />
                    </div>
                </div>
           }
            @if (contactoSeleccionado is null)
            {
                <p>Seleccioná un contacto para ver sus datos.</p>
            }
            else
            {
                <div class="border rounded p-3">
                    <h3>
                        @contactoSeleccionado.Nombre
                        @contactoSeleccionado.Apellido
                    </h3>
                    <p><strong>Teléfono:</strong> @contactoSeleccionado.Telefono</p>
                    <p><strong>Email:</strong> @contactoSeleccionado.Email</p>
                    <p><strong>Empresa:</strong> @contactoSeleccionado.Empresa</p>
                    <p><strong>Cargo:</strong> @contactoSeleccionado.Cargo</p>
                    <p><strong>Dirección:</strong> @contactoSeleccionado.Direccion</p>
                    <p><strong>Notas:</strong> @contactoSeleccionado.Notas</p>

                    <button type ="button"
                            class="btn btn-primary"
                            @onclick="EditarContacto">
                        Editar
                    </button> 

                </div>
            }
        </div>    
    </div>    
}

@code 
{
    private List<Contacto>? contactos;
    private Contacto? contactoSeleccionado;

    private void SeleccionarContacto(Contacto contacto)
    {
        contactoSeleccionado = contacto;
        modoNuevo = false;

    }

    protected override async Task OnInitializedAsync()
    {
        contactos = await Db.Contactos
            .OrderBy(c => c.Apellido)
            .ThenBy(c => c.Nombre)
            .ToListAsync();
    }
    private string textoBusqueda = "";

    private IEnumerable<Contacto> ContactosFiltrados =>
      contactos?.Where(c =>
      string.IsNullOrWhiteSpace(textoBusqueda) ||
      c.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) || 
      c.Apellido.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
      ?? Enumerable.Empty<Contacto>();

    private bool modoNuevo;
    private Contacto nuevoContacto = new();

    private void NuevoContacto()
   {
        nuevoContacto = new Contacto();
        contactoSeleccionado = null;
        mensajeError = "";
        modoNuevo = true;
    }

    private string mensajeError = "";

    private async Task GuardarContacto()
    {
        if (string.IsNullOrWhiteSpace(nuevoContacto.Nombre) ||
            string.IsNullOrWhiteSpace(nuevoContacto.Apellido) ||
            string.IsNullOrWhiteSpace(nuevoContacto.Telefono) ||
            string.IsNullOrWhiteSpace(nuevoContacto.Email))
        {
            mensajeError = "Nombre, Apellido, Telefono e Email son obligatorios.";
            return;
        }

        Db.Contactos.Add(nuevoContacto);
        await Db.SaveChangesAsync();

        contactos = await Db.Contactos
            .OrderBy(c => c.Apellido)
            .ThenBy(c => c.Nombre)
            .ToListAsync();
        
        contactoSeleccionado= nuevoContacto;
        modoNuevo = false;
        mensajeError = "";

    }

    private void CancelarNuevo()
    {
        modoNuevo = false;
        mensajeError = "";
    }

    private bool modoEditar;
    private Contacto contactoEditado = new();

    private void EditarContacto()
    {
        if(contactoSeleccionado is null)
           return;
        
        contactoEditado = new Contacto
        {
            Id = contactoSeleccionado.Id,
            Nombre = contactoSeleccionado.Nombre,
            Apellido = contactoSeleccionado.Apellido,
            Telefono = contactoSeleccionado.Telefono,
            Email = contactoSeleccionado.Email,
            Empresa = contactoSeleccionado.Empresa,
            Cargo = contactoSeleccionado.Cargo,
            Direccion = contactoSeleccionado.Direccion,
            FechaNacimiento = contactoSeleccionado.FechaNacimiento,
            Notas = contactoSeleccionado.Notas  
        };
        
        modoEditar = true;
    }
}

