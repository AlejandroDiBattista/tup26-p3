@page "/"

@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using tp5.Data
@using tp5.Models

@inject AgendaDbContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="row">

    <div class="col-md-4">

        <h3>Contactos</h3>

        @if (contactos == null)
        {
            <p>Cargando...</p>
        }
        else
        {
            <ul class="list-group">

                @foreach (var contacto in contactos)
                {
                    <li class="list-group-item @(contactoSeleccionado?.Id == contacto.Id ? "active" : "")"
                        @onclick="() => SeleccionarContacto(contacto)"
                        style="cursor:pointer">

                        @contacto.Nombre @contacto.Apellido

                    </li>
                }

            </ul>
        }

    </div>

    <div class="col-md-8">

        <h3>Detalle</h3>

        @if (contactoSeleccionado == null)
        {
            <p>Seleccione un contacto.</p>
        }
        else
        {
            <div class="card">

                <div class="card-body">

                    <p><strong>Nombre:</strong> @contactoSeleccionado.Nombre</p>

                    <p><strong>Apellido:</strong> @contactoSeleccionado.Apellido</p>

                    <p><strong>Teléfono:</strong> @contactoSeleccionado.Telefono</p>

                    <p><strong>Email:</strong> @contactoSeleccionado.Email</p>

                    <p><strong>Empresa:</strong> @contactoSeleccionado.Empresa</p>

                    <p><strong>Cargo:</strong> @contactoSeleccionado.Cargo</p>

                    <p><strong>Dirección:</strong> @contactoSeleccionado.Direccion</p>

                    <p><strong>Fecha de nacimiento:</strong> @contactoSeleccionado.FechaNacimiento</p>

                    <p><strong>Notas:</strong> @contactoSeleccionado.Notas</p>

                </div>

            </div>
        }

    </div>

</div>

@code {

    private List<Contacto>? contactos;

    private Contacto? contactoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        contactos = await Db.Contactos.ToListAsync();
    }

    private void SeleccionarContacto(Contacto contacto)
    {
        contactoSeleccionado = contacto;
    }

}