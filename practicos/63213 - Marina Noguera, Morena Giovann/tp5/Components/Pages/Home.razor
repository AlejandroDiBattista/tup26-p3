@page "/"
@using Microsoft.EntityFrameworkCore
@using tp5.Models
@inject AgendaContext Db
@rendermode InteractiveServer

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-md-4 border-end" style="height: 90vh; overflow-y: auto;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2>Agenda</h2>
                <button class="btn btn-primary btn-sm" @onclick="NuevoContacto">+ Nuevo contacto</button>
            </div>

            <input type="text" class="form-control mb-3" placeholder="Buscar por nombre o apellido..." @bind="terminoBusqueda" @bind:event="oninput" />

            <div class="list-group">
                @foreach (var c in ContactosFiltrados)
                {
                    <button type="button" class="list-group-item list-group-item-action @(contactoSeleccionado?.Id == c.Id && !modoEdicion ? "active" : "")" @onclick="() => SeleccionarContacto(c)">
                        <div class="fw-bold">@c.Nombre @c.Apellido</div>
                        <small>@c.Empresa</small>
                    </button>
                }
            </div>
        </div>

        <div class="col-md-8">
            @if (modoEdicion)
            {
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">@(contactoEdicion.Id == 0 ? "Nuevo Contacto" : "Editar Contacto")</h4>
                    </div>
                    <div class="card-body">
                        <EditForm Model="contactoEdicion" OnValidSubmit="GuardarContacto">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Nombre</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Nombre" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Apellido</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Apellido" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Teléfono</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Telefono" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <InputText type="email" class="form-control" @bind-Value="contactoEdicion.Email" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Empresa</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Empresa" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Cargo</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Cargo" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Dirección</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Direccion" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Fecha de Nacimiento</label>
                                    <InputDate class="form-control" @bind-Value="contactoEdicion.FechaNacimiento" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Notas</label>
                                    <InputTextArea class="form-control" @bind-Value="contactoEdicion.Notas"></InputTextArea>
                                </div>
                            </div>
                            <div class="mt-4 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary" @onclick="CancelarEdicion">Cancelar</button>
                                <button type="submit" class="btn btn-success">Guardar cambios</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else if (contactoSeleccionado != null)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <button class="btn btn-outline-danger btn-sm float-end ms-2" @onclick="EliminarContacto"> Eliminar</button>
                        <button class="btn btn-outline-secondary btn-sm float-end" @onclick="PrepararEdicion"> Editar</button>
                        
                        <h3 class="card-title text-primary">@contactoSeleccionado.Nombre @contactoSeleccionado.Apellido</h3>
                        <h6 class="card-subtitle mb-3 text-muted">@contactoSeleccionado.Empresa - @contactoSeleccionado.Cargo</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Email:</strong> @contactoSeleccionado.Email</p>
                                <p><strong>Teléfono:</strong> @contactoSeleccionado.Telefono</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Dirección:</strong> @contactoSeleccionado.Direccion</p>
                                <p><strong>Nacimiento:</strong> @contactoSeleccionado.FechaNacimiento?.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                        <hr />
                        <p><strong>Notas:</strong> @contactoSeleccionado.Notas</p>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                    <h4>Seleccione un contacto de la lista.</h4>
                </div>
            }
        </div>
    </div>
</div>

@code {
    List<Contacto> contactos = new();
    Contacto? contactoSeleccionado;
    
    bool modoEdicion = false;
    Contacto contactoEdicion = new();
    string terminoBusqueda = "";

    IEnumerable<Contacto> ContactosFiltrados => string.IsNullOrWhiteSpace(terminoBusqueda)
        ? contactos
        : contactos.Where(c => c.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) || 
                               c.Apellido.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CargarContactos();
    }

    async Task CargarContactos()
    {
        contactos = await Db.Contactos.OrderBy(c => c.Nombre).ToListAsync();
    }

    void SeleccionarContacto(Contacto c)
    {
        contactoSeleccionado = c;
        modoEdicion = false;
    }

    void NuevoContacto()
    {
        contactoEdicion = new Contacto();
        modoEdicion = true;
        contactoSeleccionado = null;
    }

    void PrepararEdicion()
    {
        contactoEdicion = new Contacto
        {
            Id = contactoSeleccionado!.Id,
            Nombre = contactoSeleccionado.Nombre,
            Apellido = contactoSeleccionado.Apellido,
            Telefono = contactoSeleccionado.Telefono,
            Email = contactoSeleccionado.Email,
            Empresa = contactoSeleccionado.Empresa,
            Cargo = contactoSeleccionado.Cargo,
            Direccion = contactoSeleccionado.Direccion,
            FechaNacimiento = contactoSeleccionado.FechaNacimiento,
            Notas = contactoSeleccionado.Notas
        };
        modoEdicion = true;
    }

    void CancelarEdicion()
    {
        modoEdicion = false;
    }

    async Task GuardarContacto()
    {
        if (contactoEdicion.Id == 0)
        {
            Db.Contactos.Add(contactoEdicion);
        }
        else
        {
            var entidad = await Db.Contactos.FindAsync(contactoEdicion.Id);
            if (entidad != null)
            {
                entidad.Nombre = contactoEdicion.Nombre;
                entidad.Apellido = contactoEdicion.Apellido;
                entidad.Telefono = contactoEdicion.Telefono;
                entidad.Email = contactoEdicion.Email;
                entidad.Empresa = contactoEdicion.Empresa;
                entidad.Cargo = contactoEdicion.Cargo;
                entidad.Direccion = contactoEdicion.Direccion;
                entidad.FechaNacimiento = contactoEdicion.FechaNacimiento;
                entidad.Notas = contactoEdicion.Notas;
            }
        }
        
        await Db.SaveChangesAsync();
        await CargarContactos();
        modoEdicion = false;
        contactoSeleccionado = contactos.FirstOrDefault(c => c.Id == contactoEdicion.Id) ?? contactoEdicion;
    }

    async Task EliminarContacto()
    {
        if (contactoSeleccionado != null)
        {
            Db.Contactos.Remove(contactoSeleccionado);
            await Db.SaveChangesAsync();
            await CargarContactos();
            contactoSeleccionado = null;
        }
    }
}