@page "/editar/{Id:int}"
@page "/nuevo"
@rendermode InteractiveServer
@inject AgendaDbContext Db
@inject NavigationManager Nav
@using tp5.Models
@using Microsoft.EntityFrameworkCore

<h3>@(Id.HasValue ? "Editar contacto" : "Nuevo contacto")</h3>

<EditForm Model="contacto" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-2">
        <label>Nombre</label>
        <InputText class="form-control" @bind-Value="contacto.Nombre" />
    </div>
    <div class="mb-2">
        <label>Apellido</label>
        <InputText class="form-control" @bind-Value="contacto.Apellido" />
    </div>
    <div class="mb-2">
        <label>Teléfono</label>
        <InputText class="form-control" @bind-Value="contacto.Telefono" />
    </div>
    <div class="mb-2">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="contacto.Email" />
    </div>

    <div class="mb-2">
        <label>Legajo</label>
        <InputNumber class="form-control" @bind-Value="contacto.Legajo" />
    </div>
    <div class="mb-2">
        <label>Empresa</label>
        <InputText class="form-control" @bind-Value="contacto.Empresa" />
    </div>
    <div class="mb-2">
        <label>Cargo</label>
        <InputText class="form-control" @bind-Value="contacto.Cargo" />
    </div>
    <div class="mb-2">
        <label>Dirección</label>
        <InputText class="form-control" @bind-Value="contacto.Direccion" />
    </div>
    <div class="mb-2">
        <label>Notas</label>
        <InputTextArea class="form-control" @bind-Value="contacto.Notas" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
</EditForm>

@code {
    [Parameter] public int? Id { get; set; }
    Contacto contacto = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existente = await Db.Contactos.FindAsync(Id.Value);
            if (existente != null)
            {
                contacto = existente;
            }
        }
    }

    async Task Guardar()
    {
        if (contacto.Id == 0)
        {
            Db.Contactos.Add(contacto);
        }
        else
        {
            Db.Contactos.Update(contacto);
        }
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/");
    }

    void Cancelar()
    {
        Nav.NavigateTo("/");
    }
}