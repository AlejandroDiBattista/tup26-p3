@page "/"
@rendermode InteractiveServer
@using tp5.Models
@using tp5.Services
@inject ContactoService ContactoSvc

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="agenda-layout">
    <aside class="panel-maestro">
        <div class="panel-header">
            <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Agenda</h5>
            <button class="btn btn-sm btn-primary" @onclick="NuevoContacto">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        <ul class="lista-contactos">
            @if (contactos is null)
            {
                <li class="list-item-placeholder"><i class="bi bi-hourglass-split me-2"></i>Cargando...</li>
            }
            else if (!contactos.Any())
            {
                <li class="list-item-placeholder text-muted">Sin contactos</li>
            }
            else
            {
                @foreach (var c in contactos)
                {
                    <li class="contacto-item @(contactoSeleccionado?.Id == c.Id ? "activo" : "")"
                        @onclick="() => SeleccionarContacto(c)">
                        <div class="avatar">@c.Nombre[0]@c.Apellido[0]</div>
                        <div class="info">
                            <span class="nombre">@c.Nombre @c.Apellido</span>
                            <span class="subtitulo">@(string.IsNullOrEmpty(c.Empresa) ? c.Email : c.Empresa)</span>
                        </div>
                    </li>
                }
            }
        </ul>
        @if (contactos is not null)
        {
            <div class="panel-footer">@contactos.Count contacto(s)</div>
        }
    </aside>

    <main class="panel-detalle">
        @if (modoEdicion)
        {
            <FormularioContacto Contacto="contactoForm"
                                EsNuevo="esNuevo"
                                OnGuardar="GuardarAsync"
                                OnCancelar="CancelarEdicion" />
        }
        else if (contactoSeleccionado is not null)
        {
            <DetalleContacto Contacto="contactoSeleccionado" />
        }
        else
        {
            <div class="placeholder-detalle">
                <i class="bi bi-person-vcard display-1 text-muted"></i>
                <p class="text-muted mt-3">Seleccioná un contacto para ver su información</p>
                <button class="btn btn-primary mt-2" @onclick="NuevoContacto">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo contacto
                </button>
            </div>
        }
    </main>
</div>

@code {
    private List<Contacto>? contactos;
    private Contacto? contactoSeleccionado;
    private Contacto contactoForm = new();
    private bool modoEdicion = false;
    private bool esNuevo = false;

    protected override async Task OnInitializedAsync()
        => contactos = await ContactoSvc.ObtenerTodosAsync();

    private void SeleccionarContacto(Contacto c)
    {
        contactoSeleccionado = c;
        modoEdicion = false;
    }

    private void NuevoContacto()
    {
        contactoForm = new Contacto();
        esNuevo = true;
        modoEdicion = true;
        contactoSeleccionado = null;
    }

    private async Task GuardarAsync(Contacto c)
    {
        if (esNuevo)
        {
            var nuevo = await ContactoSvc.CrearAsync(c);
            contactos = await ContactoSvc.ObtenerTodosAsync();
            contactoSeleccionado = contactos.FirstOrDefault(x => x.Id == nuevo.Id);
        }
        else
        {
            await ContactoSvc.ActualizarAsync(c);
            contactos = await ContactoSvc.ObtenerTodosAsync();
            contactoSeleccionado = contactos.FirstOrDefault(x => x.Id == c.Id);
        }
        modoEdicion = false;
    }

    private void CancelarEdicion() => modoEdicion = false;
}