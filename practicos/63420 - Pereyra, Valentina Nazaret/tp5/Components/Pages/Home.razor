@page "/"

<h1 class="text-center">Agenda de Contactos</h1>

<div class="container mt-4">

    <input class="form-control mb-3"
           placeholder="Buscar contacto" />

    <button class="btn btn-primary me-2">
        Buscar
    </button>

    <button class="btn btn-success me-2">
        Agregar Contacto
    </button>

    <button class="btn btn-danger">
        Eliminar Contacto
    </button>

    <hr />

    <div class="card mt-3">
        <div class="card-header">
            Contactos
        </div>

        <div class="card-body">

            @foreach (var contacto in contactos)
            {
                <p>
                    <strong>@contacto.Nombre</strong>
                    -
                    @contacto.Telefono
                </p>
            }

        </div>
    </div>

</div>

@code {

    private List<Contacto> contactos = new()
    {
        new Contacto { Nombre = "Juan Perez", Telefono = "381111111" },
        new Contacto { Nombre = "Ana Gomez", Telefono = "381222222" },
        new Contacto { Nombre = "Carlos Diaz", Telefono = "381333333" }
    };

    public class Contacto
    {
        public string Nombre { get; set; } = "";
        public string Telefono { get; set; } = "";
    }

}
