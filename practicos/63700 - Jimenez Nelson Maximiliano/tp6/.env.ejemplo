# cp .env.example .env

# ── Proveedor OpenAI (o compatible) ─────────────────────────────────────────
# Clave de API de OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a usar (por defecto: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# URL base alternativa (opcional) — para usar proveedores compatibles con OpenAI
# como Azure OpenAI, Groq, Ollama, etc.
# Ejemplo Groq: https://api.groq.com/openai/v1
# Dejar vacío para usar OpenAI directamente.
OPENAI_BASE_URL=
