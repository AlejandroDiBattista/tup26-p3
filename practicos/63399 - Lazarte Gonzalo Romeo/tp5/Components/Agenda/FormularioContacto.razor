@using tp5.Models
@using Microsoft.AspNetCore.Components.Forms
@* Formulario de alta y edición. Trabaja sobre una copia del contacto,
   por lo que cancelar no modifica los datos originales. *@

<EditForm Model="Contacto" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div class="d-flex align-items-center gap-3">
            <Avatar Contacto="Contacto" Grande="true" />
            <div>
                <h2 class="h3 mb-1">@Titulo</h2>
                <div class="text-secondary">@Subtitulo</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => OnCancelar.InvokeAsync()">
                Cancelar
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-floppy me-1"></i> Guardar 
            </button>
        </div>
    </div>

    <hr class="mt-0" />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="nombre">Nombre *</label>
            <InputText id="nombre" class="form-control" @bind-Value="Contacto.Nombre" />
            <ValidationMessage For="() => Contacto.Nombre" class="text-danger small" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="apellido">Apellido *</label>
            <InputText id="apellido" class="form-control" @bind-Value="Contacto.Apellido" />
            <ValidationMessage For="() => Contacto.Apellido" class="text-danger small" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="telefono">Teléfono *</label>
            <InputText id="telefono" class="form-control" @bind-Value="Contacto.Telefono" />
            <ValidationMessage For="() => Contacto.Telefono" class="text-danger small" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="email">Correo electrónico *</label>
            <InputText id="email" class="form-control" @bind-Value="Contacto.Email" />
            <ValidationMessage For="() => Contacto.Email" class="text-danger small" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="empresa">Empresa</label>
            <InputText id="empresa" class="form-control" @bind-Value="Contacto.Empresa" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="cargo">Cargo</label>
            <InputText id="cargo" class="form-control" @bind-Value="Contacto.Cargo" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="direccion">Dirección</label>
            <InputText id="direccion" class="form-control" @bind-Value="Contacto.Direccion" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="nacimiento">Fecha de nacimiento</label>
            <InputDate id="nacimiento" class="form-control" @bind-Value="Contacto.FechaNacimiento" />
        </div>

        <div class="col-12">
            <label class="form-label" for="notas">Notas</label>
            <InputTextArea id="notas" class="form-control" rows="4" @bind-Value="Contacto.Notas" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="legajo">Legajo</label>
            <InputNumber id="Legajo" class="form-control" @bind-Value="Contacto.Legajo"/>
        </div>


    </div>

    <div class="text-secondary small mt-3">* Campos obligatorios</div>

    <hr />

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick="() => OnCancelar.InvokeAsync()">
            Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy me-1"></i> Guardar 
        </button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public Contacto Contacto { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Titulo { get; set; } = "";

    [Parameter]
    public string Subtitulo { get; set; } = "";

    [Parameter]
    public EventCallback<Contacto> OnGuardar { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    private Task Guardar() => OnGuardar.InvokeAsync(Contacto);
}
