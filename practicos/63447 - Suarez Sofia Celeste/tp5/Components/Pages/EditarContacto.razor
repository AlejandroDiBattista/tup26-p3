@page "/editar/{id:int}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using tp5.Models
@using tp5.Datos

@inject AgendaContext Db
@inject NavigationManager Navigation

<div>
    <h1 class="bi bi-person-lines-fill"> Agenda de contactos </h1>
</div>
<h3>Editar Contacto</h3>

@if (contacto == null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="contacto" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <div class="container">
        <div class="row">
        <div class="col-md-6">
            <h3 class="bi bi-pencil-square">Editar Contacto</h3>

         <div class="mb-3">
            <label>Nombre</label>
            <input class="form-control" @bind="contacto.Nombre"/>
             <ValidationMessage For="() => contacto.Nombre"/>
         </div>
         <div class="mb-3">
            <label>Apellido</label>
            <input class="form-control" @bind="contacto.Apellido"/>
            <ValidationMessage For="() => contacto.Apellido"/>
         </div>
         <div class="mb-3">
            <label>Telefono</label>
            <input class="form-control" @bind="contacto.Telefono"/>
            <ValidationMessage For="() => contacto.Telefono"/>
         </div>
         <div class="mb-3">
            <label>Email</label>
            <input class="form-control" @bind="contacto.Email"/>
            <ValidationMessage For="() => contacto.Email"/>
         </div>
         <div class="mb-3">
            <label>Empresa</label>
            <input class="form-control" @bind="contacto.Empresa"/>
         </div>
         <div class="mb-3">
            <label>Cargo</label>
            <input class="form-control" @bind="contacto.Cargo"/>
         </div>
         <div class="mb-3">
            <label>Direccion</label>
            <input class="form-control" @bind="contacto.Direccion"/>
         </div>
         <div class="mb-3">
            <label>Notas</label>
            <textarea class="form-control" @bind="contacto.Notas"></textarea>
         </div>

         <button type="submit" class="btn btn-info me-2"><i class="bi bi-check-circle-fill">Guardar Cambios</i></button>
         <a href="/" class="btn btn-secondary"><i class="bi bi-x-circle">Cancelar</i></a>
        </div>
        </div>
        </div>
    </EditForm>
}

@code {

    [Parameter]
    public int Id { get; set; }
    Contacto? contacto;
    protected override async Task OnInitializedAsync()
    {
        contacto = await Db.Contactos.FirstOrDefaultAsync(c => c.Id == Id);
    }
    async Task Guardar()
    {
        await Db.SaveChangesAsync();
        Navigation.NavigateTo("/");
    }
}