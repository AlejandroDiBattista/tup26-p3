@page "/"
@using AgendaWeb.Services
@using AgendaWeb.Data
@inject ContactoService ContactoService



<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="d-flex align-items-center justify-content-center vh-100">
    <h1 class="display-3 fw-bold"><i class="bi bi-person-vcard me-3"></i>TP5: AgendaWeb</h1>
</div>

<div class="container-fluid mt-4">
    <h1 class="mb-4">📖 Agenda de Contactos</h1>

    <!-- 🔎 BUSCADOR -->
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Buscar por nombre, apellido, email o teléfono..."
                   @onchange="@((ChangeEventArgs e) => BuscarContactos(e.Value?.ToString() ?? ""))" />
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-success" @onclick="NuevoContacto">➕ Nuevo Contacto</button>
        </div>
    </div>

 <div class="row">
        <!-- 📝 PANEL MAESTRO: Lista de contactos -->
        <div class="col-md-5">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Contactos (@contactos.Count)</h5>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (contactos.Count == 0)
                    {
                        <p class="text-muted">No hay contactos para mostrar.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var contacto in contactos)
                            {
                                <button class="list-group-item list-group-item-action 
                                         @(contactoSeleccionado?.Id == contacto.Id ? "active" : "")"
                                        @onclick="@(() => SeleccionarContacto(contacto))">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@contacto.Nombre @contacto.Apellido</h6>
                                    </div>
                                    <p class="mb-1 text-muted small">@contacto.Telefono</p>
                                    <p class="mb-0 text-muted small">@contacto.Email</p>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 📋 PANEL DE DETALLE -->
        <div class="col-md-7">
            @if (contactoSeleccionado == null)
            {
                <div class="card">
                    <div class="card-body text-center text-muted">
                        <p>Selecciona un contacto para ver sus detalles.</p>
                    </div>
                </div>
            }
            else
            {
                @if (!editando)
                {
                    <!-- 👁️ VISTA DE DETALLES -->
                    <div class="card">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Detalles de @contactoSeleccionado.Nombre</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">Nombre:</dt>
                                <dd class="col-sm-8">@contactoSeleccionado.Nombre</dd>

                                <dt class="col-sm-4">Apellido:</dt>
                                <dd class="col-sm-8">@contactoSeleccionado.Apellido</dd>

                                <dt class="col-sm-4">Teléfono:</dt>
                                <dd class="col-sm-8">@contactoSeleccionado.Telefono</dd>

                                <dt class="col-sm-4">Correo:</dt>
                                <dd class="col-sm-8">
                                    <a href="mailto:@contactoSeleccionado.Email">
                                        @contactoSeleccionado.Email
                                    </a>
                                </dd>

                                @if (!string.IsNullOrEmpty(contactoSeleccionado.Empresa))
                                {
                                    <dt class="col-sm-4">Empresa:</dt>
                                    <dd class="col-sm-8">@contactoSeleccionado.Empresa</dd>
                                }

                                @if (!string.IsNullOrEmpty(contactoSeleccionado.Cargo))
                                {
                                    <dt class="col-sm-4">Cargo:</dt>
                                    <dd class="col-sm-8">@contactoSeleccionado.Cargo</dd>
                                }

                                @if (!string.IsNullOrEmpty(contactoSeleccionado.Direccion))
                                {
                                    <dt class="col-sm-4">Dirección:</dt>
                                    <dd class="col-sm-8">@contactoSeleccionado.Direccion</dd>
                                }

                                @if (contactoSeleccionado.FechaNacimiento.HasValue)
                                {
                                    <dt class="col-sm-4">Fecha de nacimiento:</dt>
                                    <dd class="col-sm-8">@contactoSeleccionado.FechaNacimiento.Value.ToString("dd/MM/yyyy")</dd>
                                }

                                @if (!string.IsNullOrEmpty(contactoSeleccionado.Notas))
                                {
                                    <dt class="col-sm-4">Notas:</dt>
                                    <dd class="col-sm-8">@contactoSeleccionado.Notas</dd>
                                }
                            </dl>

                            <div class="mt-3">
                                <button class="btn btn-warning me-2" @onclick="EditarContacto">✏️ Editar</button>
                                <button class="btn btn-danger" @onclick="EliminarContacto">🗑️ Eliminar</button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- ✏️ FORMULARIO DE EDICIÓN -->
                    <div class="card">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">Editar Contacto</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Nombre *</label>
                                <input type="text" class="form-control" @bind="contactoSeleccionado.Nombre" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Apellido *</label>
                                <input type="text" class="form-control" @bind="contactoSeleccionado.Apellido" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Teléfono *</label>
                                <input type="tel" class="form-control" @bind="contactoSeleccionado.Telefono" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Correo electrónico *</label>
                                <input type="email" class="form-control" @bind="contactoSeleccionado.Email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Empresa</label>
                                <input type="text" class="form-control" @bind="contactoSeleccionado.Empresa" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Cargo</label>
                                <input type="text" class="form-control" @bind="contactoSeleccionado.Cargo" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Dirección</label>
                                <input type="text" class="form-control" @bind="contactoSeleccionado.Direccion" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Fecha de nacimiento</label>
                                <input type="date" class="form-control" @bind="contactoSeleccionado.FechaNacimiento" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notas</label>
                                <textarea class="form-control" rows="3" @bind="contactoSeleccionado.Notas"></textarea>
                            </div>

                            <div class="mt-3">
                                <button class="btn btn-success me-2" @onclick="GuardarCambios">💾 Guardar</button>
                                <button class="btn btn-secondary" @onclick="CancelarEdicion">❌ Cancelar</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<Contacto> contactos = new();
    private Contacto? contactoSeleccionado = null;
    private bool editando = false;
    private string busqueda = "";

    // Se ejecuta cuando se carga el componente
    protected override async Task OnInitializedAsync()
    {
        await CargarContactos();
    }

    // Cargar todos los contactos
    private async Task CargarContactos()
    {
        if (string.IsNullOrWhiteSpace(busqueda))
        {
            contactos = await ContactoService.ObtenerTodosAsync();
        }
        else
        {
            contactos = await ContactoService.BuscarAsync(busqueda);
        }
    }

    // Buscar contactos
    private async Task BuscarContactos(string termino)
    {
        busqueda = termino;
        await CargarContactos();
    }

    // Seleccionar un contacto
    private void SeleccionarContacto(Contacto contacto)
    {
        contactoSeleccionado = contacto;
        editando = false;
    }

    // Modo edición
    private void EditarContacto()
    {
        editando = true;
    }

    // Guardar cambios
    private async Task GuardarCambios()
    {
        if (contactoSeleccionado != null)
        {
            await ContactoService.ActualizarAsync(contactoSeleccionado);
            editando = false;
            await CargarContactos();
        }
    }

    // Cancelar edición
    private void CancelarEdicion()
    {
        editando = false;
        // Recargar para descartar cambios
        SeleccionarContacto(contactoSeleccionado!);
    }

    // Crear nuevo contacto
    private void NuevoContacto()
    {
        contactoSeleccionado = new Contacto();
        editando = true;
    }

    // Eliminar contacto
    private async Task EliminarContacto()
    {
        if (contactoSeleccionado != null && await ContactoService.EliminarAsync(contactoSeleccionado.Id))
        {
            contactoSeleccionado = null;
            await CargarContactos();
        }
    }
}
