@page "/"
@using tp5.Data
@using tp5.Models
@rendermode InteractiveServer
@inject AgendaContext db

<h3>Agenda de Contactos</h3>

<div style="display: flex; gap: 20px;">

    <div style="width: 40%;">
    <button type="button"
            class="btn btn-primary mb-2"
            @onclick="Nuevo"
            @onclick:stopPropagation="true">
        Nuevo contacto
    </button>
        <input placeholder="Buscar..." @bind="filtro" class="form-control mb-2" />

        @foreach (var c in ContactosFiltrados)
        {
            <div class="card p-2 mb-2"
                 style="cursor:pointer"
                 @onclick="() => Seleccionar(c)">
                <b>@c.Nombre @c.Apellido</b><br />
                <small>@c.Telefono</small>
            </div>
        }
    </div>

   <div style="width: 60%;">
        <p>editando: @(editando != null)</p>

        @if (editando != null)
        {
            <h4>Nuevo contacto</h4>

            <input class="form-control mb-2" placeholder="Nombre" @bind="editando.Nombre" />
            <input class="form-control mb-2" placeholder="Apellido" @bind="editando.Apellido" />
            <input class="form-control mb-2" placeholder="Teléfono" @bind="editando.Telefono" />
            <input class="form-control mb-2" placeholder="Email" @bind="editando.Email" />

            <button class="btn btn-success" @onclick="Guardar">Guardar</button>
            <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
        }
        else if (seleccionado != null)
        {
            <h4>@seleccionado.Nombre @seleccionado.Apellido</h4>
            <p><b>Teléfono:</b> @seleccionado.Telefono</p>
            <p><b>Email:</b> @seleccionado.Email</p>
            <p><b>Empresa:</b> @seleccionado.Empresa</p>
            <p><b>Cargo:</b> @seleccionado.Cargo</p>
            <p><b>Dirección:</b> @seleccionado.Direccion</p>
            <p><b>Notas:</b> @seleccionado.Notas</p>
        }
        else
        {
            <p>Seleccioná un contacto</p>
        }
    </div>
</div>

@code {
    List<Contacto> contactos = new();
    Contacto? seleccionado;
    string filtro = "";
    Contacto? editando = null;
    protected override void OnInitialized()
    {
        contactos = db.Contactos.ToList();
    }

    IEnumerable<Contacto> ContactosFiltrados =>
        contactos.Where(c =>
            (c.Nombre + " " + c.Apellido)
            .ToLower()
            .Contains(filtro.ToLower()));

    void Seleccionar(Contacto c)
    {
        editando = new Contacto
        {
            Id = c.Id,
            Nombre = c.Nombre,
            Apellido = c.Apellido,
            Telefono = c.Telefono,
            Email = c.Email,
            Empresa = c.Empresa,
            Cargo = c.Cargo,
            Direccion = c.Direccion,
            Notas = c.Notas
        };
        seleccionado = null;
    }
    void Nuevo()
    {
        editando = new Contacto();
        seleccionado = null;
    }
    void Guardar()
    {
        if (editando.Id == 0)
        {
            db.Contactos.Add(editando);
        }
        else
        {
            var original = db.Contactos.Find(editando.Id);

            if (original != null)
            {
                original.Nombre = editando.Nombre;
                original.Apellido = editando.Apellido;
                original.Telefono = editando.Telefono;
                original.Email = editando.Email;
                original.Empresa = editando.Empresa;
                original.Cargo = editando.Cargo;
                original.Direccion = editando.Direccion;
                original.Notas = editando.Notas;
            }
        }

        db.SaveChanges();
        contactos = db.Contactos.ToList();
        editando = null;
    }
    void Cancelar()
    {
        editando = null;
    }
}
