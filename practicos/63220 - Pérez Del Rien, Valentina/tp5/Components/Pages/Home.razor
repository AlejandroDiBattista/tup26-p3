@page "/"
@rendermode InteractiveServer
@using tp5.Models
@using tp5.Data
@using Microsoft.EntityFrameworkCore
@inject AgendaContext DbContext

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="container-fluid py-4" style="max-width: 1300px; height: 100vh; display: flex; flex-direction: column;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">TP5: AgendaWeb</h2>
            <p class="text-secondary mb-0">Contactos personales y profesionales</p>
        </div>
    </div>

    <div class="row flex-grow-1 overflow-hidden" style="min-height: 0;">
        <div class="col-4 d-flex flex-column pe-0" style="height: 100%;">
            <div class="card h-100 border-0 shadow-sm">
                <div class="p-3 border-bottom">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar contacto..." 
                               @bind="busqueda" @bind:event="oninput" @onkeyup="FiltrarLista" />
                    </div>
                </div>

                <div class="list-group list-group-flush flex-grow-1 overflow-auto" style="border-radius: 0 0 0.375rem 0.375rem;">
                    @foreach (var contacto in contactosFiltrados)
                    {
                        var isSelected = contactoSeleccionado?.Id == contacto.Id;
                        <button type="button" class="list-group-item list-group-item-action p-3 border-bottom @(isSelected ? "bg-primary bg-opacity-10" : "")" 
                                style="@(isSelected ? "border-left: 4px solid #0d6efd !important;" : "border-left: 4px solid transparent !important;")"
                                @onclick="() => SeleccionarContacto(contacto)">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle d-flex justify-content-center align-items-center me-3" 
                                     style="width: 42px; height: 42px; background-color: #e0f0ff; color: #0d6efd; font-weight: 500; font-size: 0.9rem;">
                                    @ObtenerIniciales(contacto.Nombre, contacto.Apellido)
                                </div>
                                <div class="text-start">
                                    <h6 class="mb-0 fw-semibold @(isSelected ? "text-primary" : "text-dark")">@contacto.Nombre @contacto.Apellido</h6>
                                    <small class="text-secondary" style="font-size: 0.8rem;">@(string.IsNullOrWhiteSpace(contacto.Empresa) ? "Independiente" : contacto.Empresa)</small>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="col-8 h-100 ps-4">
            <div class="card h-100 border-0 shadow-sm overflow-auto">
                <div class="card-body p-5">
                    <div class="h-100 d-flex flex-column justify-content-center align-items-center text-secondary">
                        <i class="bi bi-person-lines-fill mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
                        <h4>Seleccioná un contacto</h4>
                        <p>Hacé clic en un contacto de la lista para ver sus detalles</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Contacto> contactos = new();
    private List<Contacto> contactosFiltrados = new();
    private Contacto? contactoSeleccionado;
    private string busqueda = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        contactos = await DbContext.Contactos.ToListAsync();
        FiltrarLista();
    }

    private void FiltrarLista()
    {
        if (string.IsNullOrWhiteSpace(busqueda))
            contactosFiltrados = contactos.ToList();
        else
            contactosFiltrados = contactos.Where(c => 
                c.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                c.Apellido.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                c.Empresa.Contains(busqueda, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void SeleccionarContacto(Contacto c)
    {
        contactoSeleccionado = c;
    }

    private string ObtenerIniciales(string nombre, string apellido)
    {
        string n = string.IsNullOrWhiteSpace(nombre) ? "" : nombre.Substring(0, 1).ToUpper();
        string a = string.IsNullOrWhiteSpace(apellido) ? "" : apellido.Substring(0, 1).ToUpper();
        return $"{n}{a}";
    }
}