@page "/"
@using tp5.Models
@using tp5.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject AgendaaContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-4 border-end">
            <h3 class="mb-3">Contactos</h3>
            <input type="text" class="form-control mb-3" placeholder="Buscar Contacto..."  />

            <div class="list-group">
                @if (contactos == null)
                {
                    <p><em>Cargando contactos...</em></p>
                }
                else if (!contactos.Any())
                {
                    <p>No hay contactos en la agenda.</p>
                }
                else
                {

                    @foreach (var c in contactos)
                    {
                        <button type="button" class="list-group-item list-group-item-action">
                            <strong>@c.Nombre @c.Apellido</strong><br />
                            <small class="text-muted">@c.Telefono</small>
                        </button>
                    }
                }
            </div>

            <button class="btn btn-success mt-3 w-100" @onclick="NuevoContacto">Nuevo Contacto</button>
        </div>

        <div class="col-md-8">
            <h3>Detalle del Contacto</h3>
            <p class="text-muted">Selecciona un contacto de la lista para ver sus detalles.</p>
        </div>
    </div>
</div>

@code {
    private List<Contacto> contactos;

    protected override async Task OnInitializedAsync()
    {
        contactos = await Db.Contactos.ToListAsync();
    }

    private void NuevoContacto()
    {
        // Lógica para crear un nuevo contacto
    }
}