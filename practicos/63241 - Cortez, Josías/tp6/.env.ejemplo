# Copiar este archivo como `.env` y completar la clave del proveedor a usar.
# El programa lee las variables con el prefijo del proveedor:
# OPENAI_API_URL, OPENAI_API_KEY, OPENAI_MODEL, etc.
#
# No subir el archivo `.env` al repositorio.

## Open AI | https://platform.openai.com
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=<tu_clave_api_aqui>
OPENAI_MODEL=gpt-5.5

## Google Gemini | https://aistudio.google.com/
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_API_KEY=<tu_clave_api_aqui>
GEMINI_MODEL=gemini-2.5-flash

## Groq | https://console.groq.com/
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=<tu_clave_api_aqui>
GROQ_MODEL=qwen/qwen3.6-27b

## Ollama | https://ollama.com/
OLLAMA_API_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5-coder:7b

## OpenRouter | https://openrouter.ai/
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=<tu_clave_api_aqui>
OPENROUTER_MODEL=openrouter/auto

## Hagging Face | https://huggingface.co/
HHGG_API_URL=https://api.hhgg.ai/v1/chat/completions
HHGG_API_KEY=<tu_clave_api_aqui>
HHGG_MODEL=hhgg/phoenix-2-pro:7b

## Fireworks | https://fireworks.ai/
FIREWORK_API_URL=https://api.fireworks.ai/inference/v1/chat/completions
FIREWORK_API_KEY=<tu_clave_api_aqui>
FIREWORK_MODEL=accounts/fireworks/models/glm-5p2

## Grok | https://x.ai/
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_API_KEY=<tu_clave_api_aqui>
GROK_MODEL=grok-4.3
