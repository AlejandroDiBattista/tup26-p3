@page "/"
@rendermode InteractiveServer
@using tp5.Models
@using Microsoft.EntityFrameworkCore
@inject AgendaContext Db

<div class="container-fluid mt-4">
    <h2 class="text-center mb-4"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i>TP5: AgendaWeb</h2>

    <div class="row">
        <div class="col-md-5 border-end">
            <div class="d-flex mb-3 gap-2">
                <input type="text" class="form-control" placeholder="Buscar por nombre o apellido..." 
                       @bind="textoBuscar" @bind:event="oninput" @onkeyup="Filtrar" />
                <button class="btn btn-success fw-bold" @onclick="NuevoContacto">+ Nuevo Contacto</button>
            </div>

            <div class="list-group" style="max-height: 500px; overflow-y: auto;">
                @if (contactosFiltrados == null)
                {
                    <p class="text-center">Cargando la agenda...</p>
                }
                else if (!contactosFiltrados.Any())
                {
                    <p class="text-center text-muted">No se encontraron contactos.</p>
                }
                else
                {
                    @foreach (var c in contactosFiltrados)
                    {
                        <button type="button" class="list-group-item list-group-item-action @(contactoSeleccionado?.Id == c.Id && !mostrandoFormulario ? "active" : "")"
                                @onclick="() => Seleccionar(c)">
                            <strong>@c.Apellido, @c.Nombre</strong>
                            <br />
                            <small class="text-muted">@c.Telefono</small>
                        </button>
                    }
                }
            </div>
        </div>

        <div class="col-md-7 ps-4">
            @if (mostrandoFormulario)
            {
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">@(contactoEdicion.Id == 0 ? "Nuevo Contacto" : "Editar Contacto")</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="contactoEdicion" OnValidSubmit="GuardarContacto">
                            <DataAnnotationsValidator />
                            
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label>Nombre *</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Nombre" required />
                                </div>
                                <div class="col-md-6">
                                    <label>Apellido *</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Apellido" required />
                                </div>
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label>Teléfono *</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Telefono" required />
                                </div>
                                <div class="col-md-6">
                                    <label>Correo Electrónico *</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Email" required type="email" />
                                </div>
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label>Empresa</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Empresa" />
                                </div>
                                <div class="col-md-6">
                                    <label>Cargo</label>
                                    <InputText class="form-control" @bind-Value="contactoEdicion.Cargo" />
                                </div>
                            </div>

                            <div class="mb-2">
                                <label>Dirección</label>
                                <InputText class="form-control" @bind-Value="contactoEdicion.Direccion" />
                            </div>

                            <div class="mb-2">
                                <label>Fecha de Nacimiento</label>
                                <InputDate class="form-control" @bind-Value="contactoEdicion.FechaNacimiento" />
                            </div>

                            <div class="mb-3">
                                <label>Notas</label>
                                <InputTextArea class="form-control" @bind-Value="contactoEdicion.Notas" />
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary" @onclick="CancelarEdicion">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Guardar</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else if (contactoSeleccionado != null)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="card-title text-primary mb-0">@contactoSeleccionado.Nombre @contactoSeleccionado.Apellido</h3>
                            <div>
                                <button class="btn btn-outline-primary btn-sm me-1" @onclick="EditarContacto">Editar</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="EliminarContacto">Eliminar</button>
                            </div>
                        </div>
                        <hr />
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <strong>Teléfono:</strong> <p>@contactoSeleccionado.Telefono</p>
                            </div>
                            <div class="col-sm-6">
                                <strong>Correo Electrónico:</strong> <p>@contactoSeleccionado.Email</p>
                            </div>
                            <div class="col-sm-6">
                                <strong>Empresa:</strong> <p>@(string.IsNullOrEmpty(contactoSeleccionado.Empresa) ? "---" : contactoSeleccionado.Empresa)</p>
                            </div>
                            <div class="col-sm-6">
                                <strong>Cargo:</strong> <p>@(string.IsNullOrEmpty(contactoSeleccionado.Cargo) ? "---" : contactoSeleccionado.Cargo)</p>
                            </div>
                            <div class="col-sm-12">
                                <strong>Dirección:</strong> <p>@(string.IsNullOrEmpty(contactoSeleccionado.Direccion) ? "---" : contactoSeleccionado.Direccion)</p>
                            </div>
                            <div class="col-sm-6">
                                <strong>Fecha de Nacimiento:</strong> <p>@(contactoSeleccionado.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "---")</p>
                            </div>
                            <div class="col-sm-12">
                                <strong>Notas:</strong> <p class="bg-light p-2 rounded">@(string.IsNullOrEmpty(contactoSeleccionado.Notas) ? "Sin notas adicionales." : contactoSeleccionado.Notas)</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center text-muted mt-5">
                    <i class="bi bi-person-lines-fill" style="font-size: 3rem;"></i>
                    <p class="mt-2">Selecciona un contacto de la lista o agrega uno nuevo.</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Contacto> todosLosContactos = new();
    private List<Contacto> contactosFiltrados = new();
    private Contacto? contactoSeleccionado;
    private string textoBuscar = "";
    
    // Variables para el formulario
    private bool mostrandoFormulario = false;
    private Contacto contactoEdicion = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarLista();
    }

    private async Task CargarLista()
    {
        todosLosContactos = await Db.Contactos.OrderBy(c => c.Apellido).ToListAsync();
        Filtrar();
    }

    private void Filtrar()
    {
        if (string.IsNullOrWhiteSpace(textoBuscar))
        {
            contactosFiltrados = todosLosContactos.ToList();
        }
        else
        {
            var txt = textoBuscar.ToLower();
            contactosFiltrados = todosLosContactos.Where(c => 
                (c.Nombre?.ToLower().Contains(txt) ?? false) || 
                (c.Apellido?.ToLower().Contains(txt) ?? false)).ToList();
        }
    }

    private void Seleccionar(Contacto c)
    {
        contactoSeleccionado = c;
        mostrandoFormulario = false;
    }

    // --- LOGICA CRUD ---

    private void NuevoContacto()
    {
        contactoEdicion = new Contacto(); // Limpio el form
        mostrandoFormulario = true;
        contactoSeleccionado = null;
    }

    private void EditarContacto()
    {
        if (contactoSeleccionado != null)
        {
            // Clono el objeto
            contactoEdicion = new Contacto
            {
                Id = contactoSeleccionado.Id,
                Nombre = contactoSeleccionado.Nombre,
                Apellido = contactoSeleccionado.Apellido,
                Telefono = contactoSeleccionado.Telefono,
                Email = contactoSeleccionado.Email,
                Empresa = contactoSeleccionado.Empresa,
                Cargo = contactoSeleccionado.Cargo,
                Direccion = contactoSeleccionado.Direccion,
                FechaNacimiento = contactoSeleccionado.FechaNacimiento,
                Notas = contactoSeleccionado.Notas
            };
            mostrandoFormulario = true;
        }
    }

    private void CancelarEdicion()
    {
        mostrandoFormulario = false;
    }

    private async Task GuardarContacto()
    {
        if (contactoEdicion.Id == 0)
        {
            Db.Contactos.Add(contactoEdicion);
        }
        else
        {
            var contactoOriginal = await Db.Contactos.FindAsync(contactoEdicion.Id);
            if (contactoOriginal != null)
            {
                contactoOriginal.Nombre = contactoEdicion.Nombre;
                contactoOriginal.Apellido = contactoEdicion.Apellido;
                contactoOriginal.Telefono = contactoEdicion.Telefono;
                contactoOriginal.Email = contactoEdicion.Email;
                contactoOriginal.Empresa = contactoEdicion.Empresa;
                contactoOriginal.Cargo = contactoEdicion.Cargo;
                contactoOriginal.Direccion = contactoEdicion.Direccion;
                contactoOriginal.FechaNacimiento = contactoEdicion.FechaNacimiento;
                contactoOriginal.Notas = contactoEdicion.Notas;
            }
        }
        
        await Db.SaveChangesAsync();
        await CargarLista();
        mostrandoFormulario = false;
        contactoSeleccionado = null; // Vuelve a la pantalla por defecto
    }

    private async Task EliminarContacto()
    {
        if (contactoSeleccionado != null)
        {
            Db.Contactos.Remove(contactoSeleccionado);
            await Db.SaveChangesAsync();
            await CargarLista();
            contactoSeleccionado = null;
        }
    }
}