@page "/"
@using Microsoft.EntityFrameworkCore
@using tp5.Data
@using tp5.Components.funciones
@inject AgendaContext Db

<PageTitle>TP5: AgendaWeb</PageTitle>

<div class="container py-4">
    <h1 class="text-center mb-4">AgendaWeb</h1>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Buscar</label>
            <input class="form-control"
                   placeholder="Buscar por nombre, apellido, empresa o email"
                   @bind="TextoBusqueda"
                   @bind:event="oninput" />
        </div>
    </div>

    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-primary" @onclick="MostrarNuevo">
            Nuevo
        </button>

        <button type="button" class="btn btn-warning"
                @onclick="() => MostrarEditar(seleccionado)"
                disabled="@(seleccionado is null)">
            Editar
        </button>

        <button type="button" class="btn btn-danger"
                @onclick="() => EliminarContacto(seleccionado!)"
                disabled="@(seleccionado is null)">
            Eliminar
        </button>
    </div>

    @if (contactosFiltrados.Count == 0)
    {
        <div class="alert alert-info">
            No hay contactos cargados para mostrarlos.
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-5">
                <div class="card shadow-sm">
                    <div class="card-header fw-bold">
                        Contactos
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var contacto in contactosFiltrados)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action @(seleccionado?.Id == contacto.Id ? "active" : "")"
                                    @onclick="() => Seleccionar(contacto)">
                                <div class="fw-semibold">@contacto.Apellido, @contacto.Nombre</div>
                                <div class="small">@contacto.Empresa</div>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card shadow-sm">
                    <div class="card-header fw-bold">
                        Detalles
                    </div>
                    <div class="card-body">
                        @if (mostrarFormulario)
                        {
                            <FormularioContacto
                                Visible="true"
                                EsNuevo="esNuevo"
                                Modelo="contactoEditando"
                                OnGuardar="GuardarContacto"
                                OnCancelar="CerrarFormulario" />
                        }
                        else if (seleccionado is null)
                        {
                            <p class="text-muted mb-0">Seleccione un contacto para ver sus detalles.</p>
                        }
                        else
                        {
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Nombre</dt>
                                <dd class="col-sm-8">@seleccionado.Nombre</dd>

                                <dt class="col-sm-4">Apellido</dt>
                                <dd class="col-sm-8">@seleccionado.Apellido</dd>

                                <dt class="col-sm-4">Teléfono</dt>
                                <dd class="col-sm-8">@seleccionado.Telefono</dd>

                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@seleccionado.Email</dd>

                                <dt class="col-sm-4">Empresa</dt>
                                <dd class="col-sm-8">@seleccionado.Empresa</dd>

                                <dt class="col-sm-4">Cargo</dt>
                                <dd class="col-sm-8">@seleccionado.Cargo</dd>

                                <dt class="col-sm-4">Dirección</dt>
                                <dd class="col-sm-8">@seleccionado.Direccion</dd>

                                <dt class="col-sm-4">Fecha de nacimiento</dt>
                                <dd class="col-sm-8">
                                    @(seleccionado.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")
                                </dd>

                                <dt class="col-sm-4">Notas</dt>
                                <dd class="col-sm-8">@seleccionado.Notas</dd>
                            </dl>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Contacto> contactos = [];
    private List<Contacto> contactosFiltrados = [];
    private Contacto? seleccionado;
    private string textoBusqueda = "";

    private bool mostrarFormulario = false;
    private bool esNuevo = true;
    private Contacto contactoEditando = new();

    private string TextoBusqueda
    {
        get => textoBusqueda;
        set
        {
            if (textoBusqueda == value)
                return;

            textoBusqueda = value;
            FiltrarContactos();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        contactos = await Db.Contactos
            .AsNoTracking()
            .OrderBy(c => c.Apellido)
            .ThenBy(c => c.Nombre)
            .ToListAsync();

        FiltrarContactos();
    }

    private void FiltrarContactos()
    {
        var texto = textoBusqueda.Trim();

        contactosFiltrados = contactos
            .Where(c =>
                texto == "" ||
                c.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                c.Apellido.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                c.Empresa.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                c.Email.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.Apellido)
            .ThenBy(c => c.Nombre)
            .ToList();

        if (contactosFiltrados.Count == 0)
        {
            seleccionado = null;
            return;
        }

        if (seleccionado is null || !contactosFiltrados.Any(c => c.Id == seleccionado.Id))
        {
            seleccionado = contactosFiltrados[0];
        }
    }

    private void Seleccionar(Contacto contacto)
    {
        if (mostrarFormulario)
        {
            CerrarFormulario();
        }

        seleccionado = contacto;
    }

    private void MostrarNuevo()
    {
        esNuevo = true;
        contactoEditando = new Contacto();
        mostrarFormulario = true;
    }

    private void MostrarEditar(Contacto? contacto)
    {
        if (contacto is null)
            return;

        esNuevo = false;
        contactoEditando = new Contacto
        {
            Id = contacto.Id,
            Nombre = contacto.Nombre,
            Apellido = contacto.Apellido,
            Telefono = contacto.Telefono,
            Email = contacto.Email,
            Empresa = contacto.Empresa,
            Cargo = contacto.Cargo,
            Direccion = contacto.Direccion,
            FechaNacimiento = contacto.FechaNacimiento,
            Notas = contacto.Notas
        };
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task GuardarContacto(Contacto contacto)
    {
        if (esNuevo)
        {
            Db.Contactos.Add(contacto);
        }
        else
        {
            Db.Contactos.Update(contacto);
        }

        await Db.SaveChangesAsync();

        contactos = await Db.Contactos
            .AsNoTracking()
            .OrderBy(c => c.Apellido)
            .ThenBy(c => c.Nombre)
            .ToListAsync();

        seleccionado = contactos.FirstOrDefault(c => c.Id == contacto.Id);
        FiltrarContactos();
        mostrarFormulario = false;
    }

    private async Task EliminarContacto(Contacto contacto)
    {
        Db.Contactos.Remove(contacto);
        await Db.SaveChangesAsync();

        contactos = await Db.Contactos
            .AsNoTracking()
            .OrderBy(c => c.Apellido)
            .ThenBy(c => c.Nombre)
            .ToListAsync();

        FiltrarContactos();
    }
}
