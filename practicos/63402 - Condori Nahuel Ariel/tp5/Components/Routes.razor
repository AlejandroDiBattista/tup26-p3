<Microsoft.AspNetCore.Components.Routing.Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <Microsoft.AspNetCore.Components.RouteView
            RouteData="@routeData"
            DefaultLayout="@typeof(Layout.MainLayout)" />
        <Microsoft.AspNetCore.Components.Routing.FocusOnNavigate
            RouteData="@routeData"
            Selector="h1" />
    </Found>
    <NotFound>
        <div class="text-center mt-5">
            <h1>404 - Página no encontrada</h1>
            <p>No hay nada en esta dirección.</p>
        </div>
    </NotFound>
</Microsoft.AspNetCore.Components.Routing.Router>
