@page "/"
@inject ContactoService ContactoService
@using tp5.Models

<PageTitle>TP5: AgendaWeb</PageTitle>

<h3>Agenda de Contactos</h3>

<div class="row">
    <div class="col-md-4">
        <ul class="list-group">
            @foreach (var contacto in contactos)
            {
                <li class="list-group-item">
                    @contacto.Nombre @contacto.Apellido
                </li>
            }
        </ul>
    </div>

    <div class="col-md-8">
    </div>
</div>

@code {
    private List<Contacto> contactos = new();

    protected override async Task OnInitializedAsync()
    {
        contactos = await ContactoService.ObtenerTodosAsync();
    }
}