@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IContactoService ContactoService
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>AgendaWeb</PageTitle>

<main class="agenda-shell">
    <header class="agenda-header">
        <div>
            <span class="eyebrow">TP5 · Programación III</span>
            <h1><i class="bi bi-person-vcard"></i> AgendaWeb</h1>
            <p>Todos tus contactos, organizados en un solo lugar.</p>
        </div>
        <button type="button" class="btn btn-primary btn-lg" @onclick="NuevoContacto">
            <i class="bi bi-person-plus-fill" aria-hidden="true"></i> Nuevo contacto
        </button>
    </header>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger" role="alert">@mensajeError</div>
    }

    <section class="agenda-grid">
        <aside class="contacts-panel" aria-label="Contactos de la agenda" aria-busy="@cargando">
            <div class="search-box">
                <i class="bi bi-search" aria-hidden="true"></i>
                <label class="visually-hidden" for="buscar-contactos">Buscar contactos</label>
                <input id="buscar-contactos"
                       class="form-control"
                       type="search"
                       autocomplete="off"
                       placeholder="Buscar contactos..."
                       value="@filtro"
                       @oninput="Buscar" />
                @if (!string.IsNullOrWhiteSpace(filtro))
                {
                    <button type="button" class="clear-search" title="Limpiar búsqueda"
                            aria-label="Limpiar búsqueda" @onclick="LimpiarBusqueda">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                }
            </div>

            <div class="contacts-summary" aria-live="polite">
                <strong>@contactos.Count</strong> @(contactos.Count == 1 ? "contacto" : "contactos")
            </div>

            <div class="contacts-list">
                @if (cargando)
                {
                    <div class="empty-state" role="status">
                        <div class="spinner-border text-primary" aria-hidden="true"></div>
                        <span>Cargando agenda...</span>
                    </div>
                }
                else if (contactos.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-person-x"></i>
                        <strong>Sin resultados</strong>
                        <span>Probá con otro término de búsqueda.</span>
                    </div>
                }
                else
                {
                    @foreach (var contacto in contactos)
                    {
                        <button class="contact-card @(seleccionado?.Id == contacto.Id ? "active" : "")"
                                type="button"
                                aria-pressed="@(seleccionado?.Id == contacto.Id)"
                                @onclick="() => Seleccionar(contacto)">
                            <span class="avatar">@Iniciales(contacto)</span>
                            <span class="contact-card-info">
                                <strong>@contacto.Nombre @contacto.Apellido</strong>
                                <small>@DatoSecundario(contacto)</small>
                            </span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    }
                }
            </div>
        </aside>

        <section class="detail-panel">
            @if (seleccionado is null)
            {
                <div class="empty-detail">
                    <span class="empty-detail-icon"><i class="bi bi-person-lines-fill"></i></span>
                    <h2>Seleccioná un contacto</h2>
                    <p>Elegí una persona de la lista para ver toda su información.</p>
                </div>
            }
            else
            {
                <div class="detail-heading">
                    <div class="detail-identity">
                        <span class="avatar avatar-large">@Iniciales(seleccionado)</span>
                        <div>
                            <span class="eyebrow">Ficha de contacto</span>
                            <h2>@seleccionado.Nombre @seleccionado.Apellido</h2>
                            @if (!string.IsNullOrWhiteSpace(seleccionado.Cargo) ||
                                 !string.IsNullOrWhiteSpace(seleccionado.Empresa))
                            {
                                <p>@Puesto(seleccionado)</p>
                            }
                        </div>
                    </div>
                    <div class="detail-actions">
                        <button type="button" class="btn btn-outline-primary" @onclick="EditarSeleccionado">
                            <i class="bi bi-pencil-square" aria-hidden="true"></i> Editar
                        </button>
                        <button type="button" class="btn btn-outline-danger" @onclick="SolicitarEliminar">
                            <i class="bi bi-trash3" aria-hidden="true"></i> Eliminar
                        </button>
                    </div>
                </div>

                <div class="detail-content">
                    <section class="info-section">
                        <h3>Información de contacto</h3>
                        <div class="info-grid">
                            <article class="info-item">
                                <i class="bi bi-telephone"></i>
                                <div><span>Teléfono</span><strong>@seleccionado.Telefono</strong></div>
                            </article>
                            <article class="info-item">
                                <i class="bi bi-envelope"></i>
                                <div><span>Correo electrónico</span><strong>@seleccionado.Email</strong></div>
                            </article>
                            <article class="info-item">
                                <i class="bi bi-building"></i>
                                <div><span>Empresa</span><strong>@Mostrar(seleccionado.Empresa)</strong></div>
                            </article>
                            <article class="info-item">
                                <i class="bi bi-briefcase"></i>
                                <div><span>Cargo</span><strong>@Mostrar(seleccionado.Cargo)</strong></div>
                            </article>
                            <article class="info-item info-wide">
                                <i class="bi bi-geo-alt"></i>
                                <div><span>Dirección</span><strong>@Mostrar(seleccionado.Direccion)</strong></div>
                            </article>
                            <article class="info-item">
                                <i class="bi bi-calendar-event"></i>
                                <div>
                                    <span>Fecha de nacimiento</span>
                                    <strong>@Fecha(seleccionado.FechaNacimiento)</strong>
                                </div>
                            </article>
                        </div>
                    </section>

                    <section class="notes-section">
                        <h3>Notas</h3>
                        <p>@Mostrar(seleccionado.Notas)</p>
                    </section>
                </div>
            }
        </section>
    </section>
</main>

@if (mostrarFormulario)
{
    <dialog @ref="formularioDialog" class="contact-dialog" aria-labelledby="formulario-titulo" @onclose="CerrarFormulario">
        <div class="contact-modal">
            <div class="modal-heading">
                <div>
                    <span class="eyebrow">@(modelo.Id == 0 ? "Alta" : "Modificación")</span>
                    <h2 id="formulario-titulo">@(modelo.Id == 0 ? "Nuevo contacto" : "Editar contacto")</h2>
                </div>
                <button type="button" class="btn-close" aria-label="Cerrar formulario" @onclick="CerrarFormulario"></button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeFormulario))
            {
                <div class="alert alert-danger" role="alert">@mensajeFormulario</div>
            }

            <ContactForm Modelo="modelo"
                         Guardando="guardando"
                         OnSubmit="GuardarContacto"
                         OnCancel="CerrarFormulario" />
        </div>
    </dialog>
}

@if (mostrarConfirmacion && seleccionado is not null)
{
    <dialog @ref="confirmacionDialog" class="contact-dialog" aria-labelledby="eliminar-titulo" @onclose="CancelarEliminar">
        <div class="confirm-modal">
            <span class="danger-icon"><i class="bi bi-trash3" aria-hidden="true"></i></span>
            <h2 id="eliminar-titulo">Eliminar contacto</h2>
            <p>¿Seguro que querés eliminar a <strong>@seleccionado.Nombre @seleccionado.Apellido</strong>?</p>
            <div class="modal-actions">
                <button type="button" class="btn btn-light" disabled="@eliminando" @onclick="CancelarEliminar">Cancelar</button>
                <button type="button" class="btn btn-danger" disabled="@eliminando" @onclick="EliminarContacto">
                    @(eliminando ? "Eliminando..." : "Sí, eliminar")
                </button>
            </div>
        </div>
    </dialog>
}

@code {
    private List<Contacto> contactos = [];
    private Contacto? seleccionado;
    private Contacto modelo = new();
    private string filtro = "";
    private string mensajeError = "";
    private string mensajeFormulario = "";
    private bool cargando = true;
    private bool guardando;
    private bool eliminando;
    private bool mostrarFormulario;
    private bool mostrarConfirmacion;
    private bool abrirFormularioPendiente;
    private bool abrirConfirmacionPendiente;
    private ElementReference formularioDialog;
    private ElementReference confirmacionDialog;
    private CancellationTokenSource? busquedaCts;

    protected override async Task OnInitializedAsync()
    {
        await CargarContactos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (abrirFormularioPendiente)
        {
            abrirFormularioPendiente = false;
            await JS.InvokeVoidAsync("agendaDialogs.showModal", formularioDialog);
        }

        if (abrirConfirmacionPendiente)
        {
            abrirConfirmacionPendiente = false;
            await JS.InvokeVoidAsync("agendaDialogs.showModal", confirmacionDialog);
        }
    }

    private async Task CargarContactos(
        int? seleccionarId = null,
        CancellationToken cancellationToken = default)
    {
        try
        {
            cargando = true;
            mensajeError = "";
            contactos = await ContactoService.GetContactosAsync(filtro, cancellationToken);

            if (seleccionarId.HasValue)
            {
                seleccionado = contactos.FirstOrDefault(c => c.Id == seleccionarId.Value);
            }
            else if (seleccionado is not null)
            {
                seleccionado = contactos.FirstOrDefault(c => c.Id == seleccionado.Id);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo cargar la agenda");
            mensajeError = "No se pudo acceder a la agenda. Verificá la conexión con la base de datos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Buscar(ChangeEventArgs e)
    {
        filtro = e.Value?.ToString() ?? "";
        busquedaCts?.Cancel();
        busquedaCts?.Dispose();
        busquedaCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(250, busquedaCts.Token);
            await CargarContactos(cancellationToken: busquedaCts.Token);
        }
        catch (OperationCanceledException)
        {
            // Una pulsación más reciente reemplazó esta búsqueda.
        }
    }

    private async Task LimpiarBusqueda()
    {
        filtro = "";
        busquedaCts?.Cancel();
        await CargarContactos();
    }

    private void Seleccionar(Contacto contacto)
    {
        seleccionado = contacto;
    }

    private void NuevoContacto()
    {
        modelo = new Contacto();
        mensajeFormulario = "";
        mostrarFormulario = true;
        abrirFormularioPendiente = true;
    }

    private void EditarSeleccionado()
    {
        if (seleccionado is null)
        {
            return;
        }

        modelo = Copiar(seleccionado);
        mensajeFormulario = "";
        mostrarFormulario = true;
        abrirFormularioPendiente = true;
    }

    private async Task GuardarContacto()
    {
        try
        {
            guardando = true;
            mensajeError = "";

            if (modelo.Id == 0)
            {
                await ContactoService.AddContactoAsync(modelo);
            }
            else
            {
                await ContactoService.UpdateContactoAsync(modelo);
            }

            var idGuardado = modelo.Id;
            mostrarFormulario = false;
            await CargarContactos(idGuardado);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo guardar el contacto {ContactoId}", modelo.Id);
            mensajeFormulario = "No se pudo guardar el contacto. Revisá los datos e intentá nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private void SolicitarEliminar()
    {
        mostrarConfirmacion = true;
        abrirConfirmacionPendiente = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task EliminarContacto()
    {
        if (seleccionado is null)
        {
            return;
        }

        var contactoId = seleccionado.Id;

        try
        {
            eliminando = true;
            await ContactoService.DeleteContactoAsync(contactoId);
            seleccionado = null;
            mostrarConfirmacion = false;
            await CargarContactos();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "No se pudo eliminar el contacto {ContactoId}", contactoId);
            mostrarConfirmacion = false;
            mensajeError = "No se pudo eliminar el contacto. Intentá nuevamente.";
        }
        finally
        {
            eliminando = false;
        }
    }

    private static Contacto Copiar(Contacto origen) => new()
    {
        Id = origen.Id,
        Nombre = origen.Nombre,
        Apellido = origen.Apellido,
        Telefono = origen.Telefono,
        Email = origen.Email,
        Empresa = origen.Empresa,
        Cargo = origen.Cargo,
        Direccion = origen.Direccion,
        FechaNacimiento = origen.FechaNacimiento,
        Notas = origen.Notas
    };

    private static string Iniciales(Contacto contacto)
    {
        var nombre = string.IsNullOrWhiteSpace(contacto.Nombre) ? "" : contacto.Nombre[..1];
        var apellido = string.IsNullOrWhiteSpace(contacto.Apellido) ? "" : contacto.Apellido[..1];
        return $"{nombre}{apellido}".ToUpperInvariant();
    }

    private static string DatoSecundario(Contacto contacto) =>
        !string.IsNullOrWhiteSpace(contacto.Empresa) ? contacto.Empresa : contacto.Telefono;

    private static string Puesto(Contacto contacto) =>
        string.Join(" · ", new[] { contacto.Cargo, contacto.Empresa }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string Mostrar(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "Sin especificar" : valor;

    private static string Fecha(DateOnly? fecha) =>
        fecha?.ToString("dd/MM/yyyy") ?? "Sin especificar";

    /// <summary>Cancela consultas pendientes al finalizar el circuito de Blazor.</summary>
    public void Dispose()
    {
        busquedaCts?.Cancel();
        busquedaCts?.Dispose();
    }
}
